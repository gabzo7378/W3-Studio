<Window x:Class="W3Studio.FlagsChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Opciones — Warcraft III 1.27b"
        Icon="pack://application:,,,/Assets/W3Studio.ico"
        Width="660" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win10WindowBg}"
        Foreground="{DynamicResource Win10Text}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera del campo -->
        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="TxtHeaderTitle" Text="Combate - Objetivos Permitidos" FontWeight="Bold" FontSize="13.5"/>
                <TextBlock x:Name="TxtHeaderSubtitle" Text="Marca las casillas permitidas para este campo (estándar Warcraft III 1.27b)." Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Barra de búsqueda y botones rápidos -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnSelectAll" Content="Marcar Todo" Style="{DynamicResource Win10ClassicButton}" Padding="8,3" Margin="4,0,0,0" Click="BtnSelectAll_Click"/>
                <Button x:Name="BtnClearAll" Content="Limpiar Todo" Style="{DynamicResource Win10ClassicButton}" Padding="8,3" Margin="4,0,0,0" Click="BtnClearAll_Click"/>
            </StackPanel>
            <TextBlock x:Name="LblFilter" Text="Filtrar:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtSearch" Style="{DynamicResource Win10TextBox}" Height="25" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
        </DockPanel>

        <!-- Lista de CheckBoxes en 2 columnas -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsFlags">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Margin="4,4"
                                      VerticalContentAlignment="Center"
                                      Checked="FlagCheckBox_Changed"
                                      Unchecked="FlagCheckBox_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding RawTagDisplay}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Vista previa del valor resultante -->
        <Border Grid.Row="3" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,8,0,10">
            <DockPanel>
                <TextBlock x:Name="LblPreview" Text="Valor resultante:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtResultPreview" Style="{DynamicResource Win10TextBox}" IsReadOnly="True" Height="24" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="11.5"/>
            </DockPanel>
        </Border>

        <!-- Botones Aceptar / Cancelar -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock x:Name="TxtSelectedCount" Text="0 seleccionados" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextMuted}"/>
            <Button x:Name="BtnCancel" Content="Cancelar" DockPanel.Dock="Right" Width="90" Height="27" Margin="6,0,0,0" Style="{DynamicResource Win10ClassicButton}" IsCancel="True"/>
            <Button x:Name="BtnOk" Content="Aceptar" DockPanel.Dock="Right" Width="90" Height="27" Style="{DynamicResource Win10ClassicButton}" IsDefault="True" Click="BtnOk_Click"/>
        </DockPanel>
    </Grid>
</Window>

