<Window x:Class="W3Studio.TriggerEditorWindow"
        
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Trigger Editor IDE (F4) — Warcraft III 1.27b"
        Icon="pack://application:,,,/Assets/W3Studio.ico"
        Width="1480" Height="860"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win10WindowBg}"
        Foreground="{DynamicResource Win10Text}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 1. BARRA DE MENÚ SUPERIOR -->
        <Menu Grid.Row="0" Background="{DynamicResource ThemeMenuBg}" Foreground="{DynamicResource Win10Text}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="4,1" FontSize="12">
            <MenuItem Header="_Archivo">
                <MenuItem Header="Nuevo Disparador (GUI)" InputGestureText="Ctrl+T" Click="BtnNewGuiTrigger_Click">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/Assets/Icons/triggers.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Nuevo Script (vJASS / JASS)" InputGestureText="Ctrl+U" Click="BtnNewVjassTrigger_Click">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/Assets/Icons/script_vjass.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Nueva Categoría" InputGestureText="Ctrl+K" Click="BtnNewCategory_Click">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/Assets/Icons/category_folder.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Duplicar Trigger Seleccionado" InputGestureText="Ctrl+D" Click="BtnDuplicateTrigger_Click">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/Assets/Icons/copy.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Eliminar Seleccionado" InputGestureText="Del" Click="BtnDeleteSelected_Click">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/Assets/Icons/delete.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Cerrar Editor de Triggers" Click="MenuClose_Click"/>
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem Header="Validar Sintaxis + Detectar Leaks" InputGestureText="F8" Click="BtnValidateScript_Click">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/Assets/Icons/apply.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Guardar y Compilar Mapa" InputGestureText="F7" Click="BtnSaveAndCompile_Click">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/Assets/Icons/save_compile.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Auto-Formatear JASS/vJASS" InputGestureText="Ctrl+Shift+F" Click="BtnFormatCode_Click">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/Assets/Icons/clean.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Comentar / Descomentar Líneas" InputGestureText="Ctrl+/" Click="BtnCommentToggle_Click"/>
                <MenuItem Header="Ir a Línea..." InputGestureText="Ctrl+G" Click="BtnGoToLine_Click"/>
                <MenuItem Header="Convertir a Texto Personalizado (JASS)..." Click="BtnConvertToCustomText_Click">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/Assets/Icons/convert.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Buscar en Código..." InputGestureText="Ctrl+F" Click="BtnFocusCodeSearch_Click">
                    <MenuItem.Icon>
                        <Image Source="pack://application:,,,/Assets/Icons/search.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Módulos">
                <MenuItem Header="Editor de Triggers (F4)" IsChecked="True"/>
                <MenuItem Header="Editor de Objetos (F6)" Click="MenuOpenObjectEditor_Click"/>
            </MenuItem>
            <MenuItem Header="_Ventana">
                <MenuItem Header="Mostrar/Ocultar Panel de Referencia y Variables" Click="BtnToggleInspector_Click"/>
                <MenuItem Header="Regresar a la Ventana Principal" Click="MenuClose_Click"/>
            </MenuItem>
        </Menu>
        <!-- 2. BARRA DE HERRAMIENTAS RÁPIDAS -->
        <Border Grid.Row="1" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="6,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource WeToolbarIconBtn}" Margin="0,1,3,1" ToolTip="Crear una nueva categoría para organizar triggers" Click="BtnNewCategory_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/category_folder.png" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="+ Categoría" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource WeToolbarIconBtn}" Margin="0,1,3,1" ToolTip="Crear un nuevo disparador GUI con Eventos, Condiciones y Acciones (Ctrl+T)" Click="BtnNewGuiTrigger_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/triggers.png" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="+ GUI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource WeToolbarIconBtn}" Margin="0,1,3,1" ToolTip="Crear un nuevo script vJASS / JASS (Ctrl+U)" Click="BtnNewVjassTrigger_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/script_vjass.png" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="+ Script vJASS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource WeToolbarIconBtn}" Margin="0,1,3,1" ToolTip="Duplicar el trigger seleccionado (Ctrl+D)" Click="BtnDuplicateTrigger_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/copy.png" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Duplicar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource WeToolbarIconBtn}" Margin="0,1,6,1" ToolTip="Eliminar el elemento o categoría seleccionada" Click="BtnDeleteSelected_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/delete.png" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Eliminar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,1,6,1"/>
                    <Button x:Name="BtnToolbarConvert"
                            Style="{DynamicResource WeToolbarIconBtn}"
                            Margin="0,1,4,1"
                            ToolTip="Convierte el disparador GUI seleccionado a código JASS / vJASS editable"
                            Click="BtnConvertToCustomText_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/convert.png" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Convertir a JASS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource WeToolbarIconBtn}"
                            Margin="0,1,4,1"
                            ToolTip="Auto-formatear sangría del código JASS/vJASS (Ctrl+Shift+F)"
                            Click="BtnFormatCode_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/clean.png" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Formatear" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource WeToolbarIconBtn}"
                            Margin="0,1,4,1"
                            ToolTip="Validar sintaxis WC3 1.27b (PJass/JassHelper) y analizar Memory Leaks (F8)"
                            Click="BtnValidateScript_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/apply.png" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Validar + Leaks (F8)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource WeToolbarIconBtn}"
                            Margin="0,1,4,1"
                            ToolTip="Compila los scripts, valida sintaxis y guarda el mapa (F7)"
                            Click="BtnSaveAndCompile_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/save_compile.png" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Guardar y Compilar (F7)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,1,0,1">
                    <TextBlock x:Name="TxtStatusNodeInfo" Text="Listo" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/>
                    <ToggleButton x:Name="BtnToggleInspector"
                                  IsChecked="True"
                                  Padding="8,3"
                                  Cursor="Hand"
                                  ToolTip="Mostrar/Ocultar explorador de Nativas 1.27b, Variables udg_* y Referencias del Mapa"
                                  Click="BtnToggleInspector_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/variables.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Referencia &amp; Variables" VerticalAlignment="Center" FontSize="11.5"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>
        <!-- 3. CONTENIDO PRINCIPAL: ÁRBOL (IZQ) + EDITOR (CENTRO) + EXPLORADOR JASS (DER) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="200" MaxWidth="440"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColDrawerSplitter" Width="4"/>
                <ColumnDefinition x:Name="ColRightDrawer" Width="340" MinWidth="0" MaxWidth="520"/>
            </Grid.ColumnDefinitions>
            <!-- Panel Izquierdo: Árbol de Triggers y Categorías -->
            <Grid Grid.Column="0" Background="{DynamicResource Win10PanelBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="6,4">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="Filtrar:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11.5"/>
                            <TextBox x:Name="TxtTreeFilter" Style="{DynamicResource Win10TextBox}" TextChanged="TxtTreeFilter_TextChanged"/>
                        </DockPanel>
                        <CheckBox x:Name="ChkFilterInsideCode" Content="Buscar también dentro del código JASS" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Checked="TxtTreeFilter_TextChanged" Unchecked="TxtTreeFilter_TextChanged"/>
                    </StackPanel>
                </Border>
                <TreeView Grid.Row="1"
                          x:Name="TreeTriggers"
                          Background="{DynamicResource ThemeInputBg}"
                          Foreground="{DynamicResource Win10Text}"
                          BorderThickness="0"
                          SelectedItemChanged="TreeTriggers_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Padding" Value="3,1.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource Win10Text}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="1">
                                <Image Source="{Binding IconUri}" Width="15" Height="15" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>
            <!-- Panel Central: Detalle del Trigger (Modo GUI o Modo Código IDE) -->
            <Grid Grid.Column="2" Background="{DynamicResource Win10WindowBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Encabezado del Trigger Seleccionado -->
                <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="10,6">
                    <DockPanel>
                        <!-- Selector de Modo GUI / Código a la derecha -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RbGuiMode"
                                         GroupName="TriggerMode"
                                         IsChecked="True"
                                         Margin="0,0,10,0"
                                         Checked="RbMode_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/Icons/triggers.png" Width="14" Height="14" Margin="0,0,4,0"/>
                                    <TextBlock Text="Modo GUI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbCodeMode"
                                         GroupName="TriggerMode"
                                         Margin="0,0,2,0"
                                         Checked="RbMode_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/Icons/script_vjass.png" Width="14" Height="14" Margin="0,0,4,0"/>
                                    <TextBlock Text="Modo Código (JASS / vJASS)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <!-- Nombre, Habilitado y Categoría -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="ImgTriggerIcon" Source="pack://application:,,,/Assets/Icons/triggers.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Nombre:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtTriggerName" Width="210" Height="24" Style="{DynamicResource Win10TextBox}" VerticalContentAlignment="Center" Margin="0,0,10,0" TextChanged="TxtTriggerName_TextChanged"/>
                            <CheckBox x:Name="ChkEnabled" Content="Habilitado" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" Click="ChkEnabled_Click"/>
                            <CheckBox x:Name="ChkInitiallyOn" Content="Inicialmente Activado" IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center" Click="ChkInitiallyOn_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- VISTA 1: MODO GUI (Eventos, Condiciones, Acciones + Comentario + Vista Previa JASS) -->
                <Grid Grid.Row="1" x:Name="PanelGuiMode">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="1*" MinHeight="85"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="1*" MinHeight="85"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="1.7*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <!-- Comentario del Trigger -->
                    <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="8,4">
                        <DockPanel>
                            <TextBlock Text="Comentario:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtTriggerComment" Style="{DynamicResource Win10TextBox}" VerticalContentAlignment="Center" TextChanged="TxtTriggerComment_TextChanged"/>
                        </DockPanel>
                    </Border>
                    <!-- SECCIÓN 1: EVENTOS -->
                    <Grid Grid.Row="1" Margin="8,4,8,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="6,2">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Eventos" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtEventsCount" Text="(0)" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,4,0" Click="BtnAddEvent_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/add.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Añadir Evento..."/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Modificar..." Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,4,0" Click="BtnEditEvent_Click"/>
                                    <Button Content="Borrar" Style="{DynamicResource WeToolbarIconBtn}" Click="BtnDeleteEvent_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ListBox Grid.Row="1"
                                 x:Name="ListEvents"
                                 Background="{DynamicResource Win10WindowBg}"
                                 Foreground="{DynamicResource Win10Text}"
                                 BorderBrush="{DynamicResource Win10Border}"
                                 BorderThickness="1"
                                 MouseDoubleClick="ListEvents_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,0,6,0" VerticalAlignment="Center" Click="GuiElementEnabled_Click" ToolTip="Activar/desactivar este evento sin borrarlo"/>
                                        <TextBlock Text="{Binding IconGlyph}" Margin="0,0,6,0" Foreground="#0066CC"/>
                                        <TextBlock Text="{Binding DisplayText}" FontWeight="Medium"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>
                    <!-- SECCIÓN 2: CONDICIONES -->
                    <Grid Grid.Row="3" Margin="8,2,8,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="6,2">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Condiciones" FontWeight="Bold" Foreground="#C060E0" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtConditionsCount" Text="(0)" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,4,0" Click="BtnAddCondition_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/add.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Añadir Condición..."/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Modificar..." Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,4,0" Click="BtnEditCondition_Click"/>
                                    <Button Content="Borrar" Style="{DynamicResource WeToolbarIconBtn}" Click="BtnDeleteCondition_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ListBox Grid.Row="1"
                                 x:Name="ListConditions"
                                 Background="{DynamicResource Win10WindowBg}"
                                 Foreground="{DynamicResource Win10Text}"
                                 BorderBrush="{DynamicResource Win10Border}"
                                 BorderThickness="1"
                                 MouseDoubleClick="ListConditions_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,0,6,0" VerticalAlignment="Center" Click="GuiElementEnabled_Click" ToolTip="Activar/desactivar esta condición sin borrarla"/>
                                        <TextBlock Text="{Binding IconGlyph}" Margin="0,0,6,0" Foreground="#990099"/>
                                        <TextBlock Text="{Binding DisplayText}" FontWeight="Medium"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>
                    <!-- SECCIÓN 3: ACCIONES -->
                    <Grid Grid.Row="5" Margin="8,2,8,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="6,2">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Acciones" FontWeight="Bold" Foreground="#E68A00" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtActionsCount" Text="(0)" Foreground="{DynamicResource ThemeTextMuted}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,4,0" Click="BtnAddAction_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/add.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Añadir Acción..."/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Modificar..." Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,4,0" Click="BtnEditAction_Click"/>
                                    <Button Content="Borrar" Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,4,0" Click="BtnDeleteAction_Click"/>
                                    <Button Content="▲ Subir" Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,2,0" Click="BtnMoveActionUp_Click"/>
                                    <Button Content="▼ Bajar" Style="{DynamicResource WeToolbarIconBtn}" Click="BtnMoveActionDown_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ListBox Grid.Row="1"
                                 x:Name="ListActions"
                                 Background="{DynamicResource Win10WindowBg}"
                                 Foreground="{DynamicResource Win10Text}"
                                 BorderBrush="{DynamicResource Win10Border}"
                                 BorderThickness="1"
                                 MouseDoubleClick="ListActions_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,0,6,0" VerticalAlignment="Center" Click="GuiElementEnabled_Click" ToolTip="Activar/desactivar esta acción sin borrarla"/>
                                        <TextBlock Text="{Binding IconGlyph}" Margin="0,0,6,0" Foreground="#CC6600"/>
                                        <TextBlock Text="{Binding DisplayText}" FontWeight="Medium"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <!-- Vista previa expandible de JASS generado en vivo -->
                    <Expander Grid.Row="6" x:Name="ExpGuiJassPreview"
                              Header="Vista Previa en Vivo: JASS Generado (WC3 1.27b)"
                              Margin="8,2,8,4"
                              IsExpanded="False"
                              Background="{DynamicResource Win10PanelBg}"
                              Expanded="ExpGuiJassPreview_Expanded">
                        <avalonEdit:TextEditor x:Name="GuiPreviewEditor"
                                               Height="160"
                                               IsReadOnly="True"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Background="#1E1E1E"
                                               Foreground="#E6EDF3"
                                               ShowLineNumbers="True"
                                               LineNumbersForeground="#858585"/>
                    </Expander>
                    <!-- Barra Inferior GUI: Botón de Conversión Directa -->
                    <Border Grid.Row="7" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,1,0,0" Padding="8,4">
                        <DockPanel>
                            <Button Style="{DynamicResource Win10ClassicButton}" Padding="10,3" HorizontalAlignment="Left" Click="BtnConvertToCustomText_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/Icons/convert.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                    <TextBlock Text="Convertir a Texto Personalizado (JASS / vJASS)"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Puedes activar/desactivar eventos, condiciones o acciones individuales con su casilla."
                                       Foreground="{DynamicResource ThemeTextMuted}"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="8,0,0,0"/>
                        </DockPanel>
                    </Border>
                </Grid>
                <!-- VISTA 2: MODO CÓDIGO (Editor IDE JASS / vJASS con IntelliSense, Folding, Leaks y Diagnósticos) -->
                <Grid Grid.Row="1" x:Name="PanelCodeMode" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="150" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="8,3">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnCommentToggle" Content="// Comentar" Style="{DynamicResource Win10ClassicButton}" Margin="0,0,4,0" ToolTip="Comentar/Descomentar selección (Ctrl+/)" Click="BtnCommentToggle_Click"/>
                                <Button x:Name="BtnFormatCode" Content="Formatear" Style="{DynamicResource Win10ClassicButton}" Margin="0,0,4,0" ToolTip="Auto-identar JASS/vJASS (Ctrl+Shift+F)" Click="BtnFormatCode_Click"/>
                                <Button x:Name="BtnGoToLine" Content="Línea..." Style="{DynamicResource Win10ClassicButton}" Margin="0,0,6,0" ToolTip="Ir a línea (Ctrl+G)" Click="BtnGoToLine_Click"/>
                                <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtCodeSearch" Width="135" Style="{DynamicResource Win10TextBox}" KeyDown="TxtCodeSearch_KeyDown"/>
                                <Button Content="Buscar" Style="{DynamicResource Win10ClassicButton}" Margin="3,0,5,0" Click="BtnFindInCode_Click"/>
                                <Button x:Name="BtnSyncFromGui" Content="Regenerar desde GUI" Style="{DynamicResource Win10ClassicButton}" Margin="0,0,2,0" ToolTip="Regenera el código JASS basándose en los bloques GUI" Click="BtnSyncFromGui_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCodeModeTitle" Text="Código JASS / vJASS" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtCodeModeMeta" Text="" Foreground="{DynamicResource ThemeTextMuted}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <avalonEdit:TextEditor Grid.Row="1"
                                           x:Name="CodeEditor"
                                           FontFamily="Consolas"
                                           FontSize="13.5"
                                           Background="#1E1E1E"
                                           Foreground="#E6EDF3"
                                           ShowLineNumbers="True"
                                           LineNumbersForeground="#858585"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"
                                           TextChanged="CodeEditor_TextChanged"/>
                    <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>
                    <!-- Panel inferior de Diagnósticos / Leaks / Errores WC3 1.27b -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="8,2">
                            <DockPanel>
                                <TextBlock x:Name="TxtDiagnosticsSummary" Text="Diagnósticos y Detector de Leaks (WC3 1.27b) — Ctrl+Space autocompletado • ( para parámetros" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Validar + Leaks (F8)" Style="{DynamicResource Win10ClassicButton}" Padding="8,1" Click="BtnValidateScript_Click"/>
                            </DockPanel>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  x:Name="GridDiagnostics"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MouseDoubleClick="GridDiagnostics_MouseDoubleClick"
                                  Background="{DynamicResource Win10WindowBg}"
                                  Foreground="{DynamicResource Win10Text}"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="" Binding="{Binding SeverityIcon}" Width="30"/>
                                <DataGridTextColumn Header="Severidad" Binding="{Binding Severity}" Width="75"/>
                                <DataGridTextColumn Header="Detector / Tool" Binding="{Binding Source}" Width="115"/>
                                <DataGridTextColumn Header="Trigger / Archivo" Binding="{Binding TriggerOrFile}" Width="150"/>
                                <DataGridTextColumn Header="Línea" Binding="{Binding DisplayLine}" Width="75"/>
                                <DataGridTextColumn Header="Mensaje (Doble clic para ir a la línea)" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>
            <!-- Panel Derecho: Explorador de Nativas WC3 1.27b, Variables udg_* y Objetos del Mapa -->
            <Border Grid.Column="4" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0">
                <TabControl x:Name="TabRightDrawer" Background="{DynamicResource Win10WindowBg}" BorderThickness="0">
                    <!-- TAB 1: NATIVAS WC3 1.27b -->
                    <TabItem Header="Nativas 1.27b">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtNativeSearch" Style="{DynamicResource Win10TextBox}" TextChanged="TxtNativeSearch_TextChanged"/>
                            </DockPanel>
                            <ComboBox Grid.Row="1" x:Name="CboNativeKind" Height="24" Margin="0,0,0,6" SelectionChanged="TxtNativeSearch_TextChanged">
                                <ComboBoxItem Content="Todas (Natives + Blizzard.j + Constantes)" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="Nativas common.j" Tag="Native"/>
                                <ComboBoxItem Content="Helpers blizzard.j (BJ)" Tag="BJ"/>
                                <ComboBoxItem Content="Constantes WC3" Tag="Constant"/>
                                <ComboBoxItem Content="Snippets vJASS / Sin Leaks" Tag="Snippet"/>
                            </ComboBox>
                            <ListBox Grid.Row="2" x:Name="ListNatives"
                                     Background="{DynamicResource Win10WindowBg}"
                                     Foreground="{DynamicResource Win10Text}"
                                     BorderBrush="{DynamicResource Win10Border}"
                                     BorderThickness="1"
                                     SelectionChanged="ListNatives_SelectionChanged"
                                     MouseDoubleClick="ListNatives_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Foreground="#6B7280" FontSize="10.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="3" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtNativeSignature" Text="Selecciona una nativa o snippet (doble clic para insertar)." FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtNativeDesc" Text="" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <Button Content="Insertar en Editor" Style="{DynamicResource Win10ClassicButton}" Padding="8,3" HorizontalAlignment="Right" Click="BtnInsertSelectedNative_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <!-- TAB 2: VARIABLES GLOBALES (udg_*) -->
                    <TabItem Header="Variables (udg_)">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,4,0" Click="BtnNewVariable_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/Icons/add.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                        <TextBlock Text="Nueva"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Editar" Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,4,0" Click="BtnEditVariable_Click"/>
                                <Button Content="Eliminar" Style="{DynamicResource WeToolbarIconBtn}" Margin="0,0,4,0" Click="BtnDeleteVariable_Click"/>
                                <Button Content="Insertar udg_" Style="{DynamicResource WeToolbarIconBtn}" Click="BtnInsertVariable_Click" ToolTip="Inserta udg_&lt;Nombre&gt; en el cursor del editor"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" x:Name="GridVariables"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      Background="{DynamicResource Win10WindowBg}"
                                      Foreground="{DynamicResource Win10Text}"
                                      BorderBrush="{DynamicResource Win10Border}"
                                      BorderThickness="1"
                                      MouseDoubleClick="GridVariables_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Identificador" Binding="{Binding JassIdentifier}" Width="125"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="75"/>
                                    <DataGridTextColumn Header="Array" Binding="{Binding ArrayDisplay}" Width="55"/>
                                    <DataGridTextColumn Header="Inicial" Binding="{Binding InitialValue}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Formulario inline para crear/editar variable -->
                            <Border Grid.Row="2" x:Name="PanelVarEditor" Visibility="Collapsed"
                                    Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}"
                                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtVarFormTitle" Text="Nueva Variable Global (udg_*)" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Nombre (sin 'udg_'):" FontSize="11"/>
                                    <TextBox x:Name="TxtVarName" Height="23" Style="{DynamicResource Win10TextBox}" Margin="0,2,0,5"/>
                                    <TextBlock Text="Tipo JASS:" FontSize="11"/>
                                    <ComboBox x:Name="CboVarType" IsEditable="True" Height="23" Margin="0,2,0,5">
                                        <ComboBoxItem Content="integer" IsSelected="True"/>
                                        <ComboBoxItem Content="real"/>
                                        <ComboBoxItem Content="boolean"/>
                                        <ComboBoxItem Content="string"/>
                                        <ComboBoxItem Content="unit"/>
                                        <ComboBoxItem Content="location"/>
                                        <ComboBoxItem Content="group"/>
                                        <ComboBoxItem Content="force"/>
                                        <ComboBoxItem Content="effect"/>
                                        <ComboBoxItem Content="timer"/>
                                        <ComboBoxItem Content="trigger"/>
                                        <ComboBoxItem Content="rect"/>
                                        <ComboBoxItem Content="player"/>
                                        <ComboBoxItem Content="item"/>
                                        <ComboBoxItem Content="destructable"/>
                                        <ComboBoxItem Content="sound"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkVarIsArray" Content="Es Array" Margin="0,2,0,5"/>
                                    <TextBlock Text="Valor Inicial (opcional):" FontSize="11"/>
                                    <TextBox x:Name="TxtVarInitVal" Height="23" Style="{DynamicResource Win10TextBox}" Margin="0,2,0,8"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Guardar" Style="{DynamicResource Win10ClassicButton}" Padding="10,2" Margin="0,0,6,0" Click="BtnSaveVariable_Click"/>
                                        <Button Content="Cancelar" Style="{DynamicResource Win10ClassicButton}" Padding="10,2" Click="BtnCancelVariable_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <!-- TAB 3: MAPA (gg_rct_*, gg_unit_*, gg_trg_*, RAWCODES) -->
                    <TabItem Header="Mapa (gg_ &amp; IDs)">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtMapRefSearch" Style="{DynamicResource Win10TextBox}" TextChanged="TxtMapRefSearch_TextChanged"/>
                            </DockPanel>
                            <ListBox Grid.Row="1" x:Name="ListMapRefs"
                                     Background="{DynamicResource Win10WindowBg}"
                                     Foreground="{DynamicResource Win10Text}"
                                     BorderBrush="{DynamicResource Win10Border}"
                                     BorderThickness="1"
                                     MouseDoubleClick="ListMapRefs_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayKind}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5"/>
                                                <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Content="Insertar Referencia en Código" Style="{DynamicResource Win10ClassicButton}" Margin="0,6,0,0" Padding="8,4" HorizontalAlignment="Right" Click="BtnInsertSelectedMapRef_Click"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
