<Window x:Class="W3Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:controls="clr-namespace:W3Studio.Controls"
        mc:Ignorable="d"
        Title="Warcraft III World Editor — W3 Studio (1.27b)"
        Icon="pack://application:,,,/Assets/W3Studio.ico"
        Width="1540" Height="920"
        MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Win10WindowBg}"
        Foreground="{DynamicResource Win10Text}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <!-- 1. BARRA DE MENÚ LIMPIA Y DIRECTA (INCLUYE CONFIGURACIÓN Y TEMAS) -->
        <Menu Grid.Row="0" Background="{DynamicResource ThemeMenuBg}" Foreground="{DynamicResource Win10Text}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="4,1" FontSize="12">
            <MenuItem Header="_Archivo">
                <MenuItem Header="Abrir Mapa (.w3x / .w3m)..." InputGestureText="Ctrl+O" Click="BtnOpenMap_Click"/>
                <MenuItem Header="Guardar Mapa" InputGestureText="Ctrl+S" Click="BtnSaveMap_Click"/>
                <MenuItem Header="Cerrar Mapa" Click="BtnCloseMap_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuTestMap" Header="Probar Mapa en Warcraft III" InputGestureText="F9" IsEnabled="False" Click="BtnTestMap_Click"/>
                <MenuItem Header="Cambiar Directorio de Warcraft III..." Click="BtnBrowseWar3Dir_Click"/>
                <Separator/>
                <MenuItem Header="Salir" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem Header="Buscar en Trigger Actual..." InputGestureText="Ctrl+F" Click="BtnFindInCode_Click"/>
                <MenuItem Header="Búsqueda Global en el Mapa..." InputGestureText="Ctrl+Shift+F" Click="BtnFocusGlobalSearch_Click"/>
                <MenuItem Header="Variables Globales (war3map.wtg)..." InputGestureText="Ctrl+B" Click="BtnFocusGlobalSearch_Click"/>
            </MenuItem>
            <MenuItem Header="_Ver">
                <MenuItem Header="Vista Estándar del Editor (Distancia 1650)" Click="BtnStandardEditorCamera_Click"/>
                <MenuItem Header="Ver Mapa Completo" InputGestureText="Home" Click="BtnResetMapCamera_Click"/>
                <MenuItem Header="Ir a Siguiente Start Location" Click="BtnCycleStartLocations_Click"/>
                <Separator/>
                <MenuItem Header="Mostrar Cuadrícula (Grid)" InputGestureText="G" Click="MenuToggleGrid_Click"/>
                <MenuItem Header="Mostrar Unidades" InputGestureText="U" Click="MenuToggleUnits_Click"/>
                <MenuItem Header="Mostrar Árboles y Doodads" InputGestureText="D" Click="MenuToggleDoodads_Click"/>
                <MenuItem Header="Mostrar Regiones (Rects)" InputGestureText="R" Click="MenuToggleRegions_Click"/>
                <Separator/>
                <MenuItem Header="Mostrar / Ocultar Tool Palette" Click="MenuToggleToolPalette_Click"/>
                <MenuItem Header="Paleta de Terreno y Precipicios (Terrain)" Click="MenuSelectTerrainPalette_Click"/>
            </MenuItem>
            <MenuItem Header="_Módulos">
                <MenuItem Header="Mapa y Terreno" InputGestureText="F3" Click="BtnFocusMapTab_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/terrain.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Editor de Triggers (vJASS / JASS)" InputGestureText="F4" Click="BtnFocusTriggers_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/triggers.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Editor de Objetos (Unidades, Ítems, Habilidades)" InputGestureText="F6" Click="BtnFocusObjects_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/objects.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Gestor de Importaciones" InputGestureText="F12" Click="BtnFocusImports_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/imports.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Icon Manager (Editor de Iconos .blp)" Click="BtnOpenIconManager_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/icon_manager.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Optimizador de Mapa (WC3 Optimizer 5.0)..." Click="BtnOpenOptimizer_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/optimizer.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Variables Globales y Búsqueda" InputGestureText="Ctrl+B" Click="BtnFocusGlobalSearch_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/variables.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Escenario">
                <MenuItem Header="Descripción y Opciones del Mapa..." Click="BtnOpenScenarioDescription_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/scenario.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Propiedades de Jugadores (Player Properties)..." Click="BtnOpenScenarioPlayers_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/tab_units.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Fuerzas y Alianzas (Forces)..." Click="BtnOpenScenarioForces_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/scenario.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Avanzado">
                <MenuItem Header="Constantes de Juego (Gameplay Constants)..." Click="BtnOpenGameplayConstants_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/constants.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Interfaz de Juego (Game Interface)..." Click="BtnOpenGameInterface_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/icon_manager.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="MenuConfigRoot" Header="_Configuración">
                <MenuItem x:Name="MenuLanguageSub" Header="🌐 _Idioma">
                    <MenuItem x:Name="MenuLangEs" Header="Español" IsCheckable="True" Click="MenuLanguage_Click" Tag="es"/>
                    <MenuItem x:Name="MenuLangEn" Header="English" IsCheckable="True" Click="MenuLanguage_Click" Tag="en"/>
                </MenuItem>
                <MenuItem x:Name="MenuThemeSub" Header="_Tema Visual">
                    <MenuItem Header="Modo Sistema (Clásico World Editor)" Click="MenuTheme_Click" Tag="System"/>
                    <MenuItem Header="Modo Oscuro" Click="MenuTheme_Click" Tag="Dark"/>
                    <MenuItem Header="Modo Blanco" Click="MenuTheme_Click" Tag="Light"/>
                    <MenuItem Header="Modo Rosado" Click="MenuTheme_Click" Tag="Pink"/>
                    <MenuItem Header="Modo Verde Oscuro" Click="MenuTheme_Click" Tag="DarkGreen"/>
                    <MenuItem Header="Modo Azul Oscuro" Click="MenuTheme_Click" Tag="DarkBlue"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MenuWar3Dir" Header="Directorio de Warcraft III..." Click="BtnBrowseWar3Dir_Click"/>
                <MenuItem x:Name="MenuWindowedMode" Header="Probar Mapa en Modo Ventana (-window)" IsCheckable="True" IsChecked="True" Click="MenuToggleWindowed_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSettingsItem" Header="Opciones y Preferencias..." Click="MenuSettings_Click" InputGestureText="Ctrl+P">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/Icons/settings.png" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- 2. BARRA DE HERRAMIENTAS COMPACTA (MÓDULOS + GUARDAR/PROBAR + DIRECTORIO W3 + CONFIGURACIÓN) -->
        <Border Grid.Row="1" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="6,2">
            <DockPanel LastChildFill="False">
                <!-- Selector directo del directorio de Warcraft III y configuración a la derecha -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Warcraft III:" VerticalAlignment="Center" Foreground="{DynamicResource Win10Text}" FontSize="11.5" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtTopWar3Dir"
                             Width="210"
                             Height="22"
                             Style="{StaticResource Win10TextBox}"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             FontSize="11"
                             ToolTip="Directorio de Warcraft III 1.27b (war3.exe y MPQs base)"/>
                    <Button Style="{StaticResource WeToolbarIconBtn}"
                            Padding="6,1"
                            Margin="3,0,4,0"
                            ToolTip="Seleccionar carpeta de Warcraft III (war3.exe)"
                            Click="BtnBrowseWar3Dir_Click">
                        <Image Source="pack://application:,,,/Assets/Icons/open.png" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <CheckBox x:Name="ChkWindowedTest"
                              Content="Ventana"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              FontSize="11.5"
                              Foreground="{DynamicResource Win10Text}"
                              ToolTip="Iniciar Warcraft III en modo ventana (-window)"
                              Checked="ChkWindowedTest_Changed"
                              Unchecked="ChkWindowedTest_Changed"/>
                    <Button Style="{StaticResource WeToolbarIconBtn}"
                            Padding="6,1"
                            Margin="6,0,0,0"
                            ToolTip="Configuración, Temas y Preferencias (Ctrl+P)"
                            Click="MenuSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/settings.png" Width="15" Height="15" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Config" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Botones esenciales del Editor a la izquierda -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" ToolTip="Abrir Mapa .w3x / .w3m (Ctrl+O)" Click="BtnOpenMap_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/open.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Abrir" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" ToolTip="Guardar Mapa (Ctrl+S)" Click="BtnSaveMap_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/save.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Guardar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Win10Border}" Margin="5,0"/>

                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" ToolTip="Ver Terreno, Árboles y Unidades del Mapa (F3)" Click="BtnFocusMapTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/terrain.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Terreno (F3)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" FontWeight="SemiBold" ToolTip="Editor de Triggers y Código vJASS/JASS (F4)" Click="BtnFocusTriggers_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/triggers.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Triggers (F4)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" FontWeight="SemiBold" ToolTip="Editor de Objetos: Unidades, Ítems, Habilidades (F6)" Click="BtnFocusObjects_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/objects.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Objetos (F6)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" ToolTip="Gestor de Archivos Importados (F12)" Click="BtnFocusImports_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/imports.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Imports (F12)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" FontWeight="SemiBold" ToolTip="Icon Manager estilo Button Manager (BTN, PAS, ATC, recuadros de color y DISBTN automático)" Click="BtnOpenIconManager_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/icon_manager.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Icon Manager" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" FontWeight="SemiBold" ToolTip="Optimizador de Mapa estilo WC3 Map Optimizer 5.0 (JASS, Strings, Bloat y Protección MPQ)" Click="BtnOpenOptimizer_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/optimizer.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Optimizador" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" FontWeight="SemiBold" ToolTip="Escenario: Propiedades del Mapa, Jugadores y Fuerzas" Click="BtnOpenScenarioDescription_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/scenario.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Escenario" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" ToolTip="Avanzado: Gameplay Constants y Game Interface" Click="BtnOpenGameplayConstants_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/constants.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Constantes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource WeToolbarIconBtn}" Padding="7,2" ToolTip="Variables Globales y Buscador (Ctrl+B)" Click="BtnFocusGlobalSearch_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/variables.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Variables" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Win10Border}" Margin="5,0"/>

                    <Button x:Name="BtnSaveAndCompile" Style="{StaticResource WeToolbarIconBtn}" Padding="8,2" Background="{DynamicResource ThemeWarningBg}" BorderBrush="{DynamicResource ThemeWarningBorder}" FontWeight="SemiBold" ToolTip="Guardar y compilar el mapa completo (Ctrl+S / F7). Si hay errores en los scripts, se mostrarán y no se podrá probar." Click="BtnSaveAndCompile_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/save_compile.png" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Guardar (Ctrl+S / F7)" Foreground="{DynamicResource ThemeWarningText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTestMap" Style="{StaticResource WeToolbarIconBtn}" Padding="9,2" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" FontWeight="Bold" IsEnabled="False" ToolTip="Lanzar y probar el mapa en Warcraft III (F9). Se activa cuando el mapa esté guardado y compilado sin errores." Click="BtnTestMap_Click" Margin="3,1,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/play.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Probar (F9)" Foreground="{DynamicResource ThemeSuccessText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. CUERPO CENTRAL: SIDEBAR IZQUIERDO CLÁSICO WORLD EDITOR + ÁREA PRINCIPAL -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO CLÁSICO WORLD EDITOR (Adaptable al tema activo) -->
            <Border Grid.Column="0" Background="{DynamicResource Win10SidebarGray}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Casillas Superiores -->
                    <Border Grid.Row="0" Background="{DynamicResource Win10SidebarGray}" Padding="6,10,6,8">
                        <StackPanel>
                            <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="5,3" Margin="0,1">
                                <CheckBox x:Name="ChkNeutralBuildings" Content="Show Neutral Building Icons" IsChecked="True" FontSize="11.5" Checked="LayerCheckbox_Changed" Unchecked="LayerCheckbox_Changed"/>
                            </Border>
                            <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="5,3" Margin="0,1">
                                <CheckBox x:Name="ChkCreepCamps" Content="Show Creep Camp Icons" IsChecked="True" FontSize="11.5" Checked="LayerCheckbox_Changed" Unchecked="LayerCheckbox_Changed"/>
                            </Border>
                            <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="5,3" Margin="0,1">
                                <CheckBox x:Name="ChkViewGameMinimap" Content="View Game Minimap" IsChecked="True" FontSize="11.5" Checked="LayerCheckbox_Changed" Unchecked="LayerCheckbox_Changed"/>
                            </Border>
                            <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="5,3" Margin="0,1">
                                <CheckBox x:Name="ChkShowDoodads" Content="Show Trees &amp; Doodads" IsChecked="True" FontSize="11.5" Checked="LayerCheckbox_Changed" Unchecked="LayerCheckbox_Changed"/>
                            </Border>
                            <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="5,3" Margin="0,1">
                                <CheckBox x:Name="ChkShowRegions" Content="Show Regions (Rects)" IsChecked="False" FontSize="11.5" Checked="LayerCheckbox_Changed" Unchecked="LayerCheckbox_Changed"/>
                            </Border>
                            <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="5,3" Margin="0,1">
                                <CheckBox x:Name="ChkShowGrid" Content="Show Terrain Grid (G)" IsChecked="False" FontSize="11.5" Checked="LayerCheckbox_Changed" Unchecked="LayerCheckbox_Changed"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- MINIMAPA INTERACTIVO EN VIVO (Con rectángulo blanco de cámara) -->
                    <Border Grid.Row="1" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,1,0,1" Padding="6">
                        <Border Width="200" Height="200" Background="#242424" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1"
                                MouseLeftButtonDown="MinimapBox_MouseDown"
                                MouseMove="MinimapBox_MouseMove">
                            <Grid Width="198" Height="198" ClipToBounds="True">
                                <Image x:Name="ImgSidebarMinimap" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Canvas x:Name="CanvasMinimapOverlay" Width="198" Height="198" IsHitTestVisible="False">
                                    <Rectangle x:Name="RectMinimapCamera"
                                               Stroke="White"
                                               StrokeThickness="1.5"
                                               Fill="#18FFFFFF"
                                               Width="60" Height="60"
                                               Canvas.Left="69" Canvas.Top="69"/>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Controles Distance / Rotate / Lighting -->
                    <Border Grid.Row="2" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="5,4">
                        <StackPanel>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Distance:" VerticalAlignment="Center" FontSize="11.5"/>
                                <TextBox Grid.Column="1" x:Name="TxtSidebarDistance" Text="1650" Style="{StaticResource Win10TextBox}" IsReadOnly="True" HorizontalContentAlignment="Right" Margin="0,0,2,0"/>
                                <Button Grid.Column="2" Content="◄" Style="{StaticResource Win10ClassicButton}" Padding="0" FontSize="9" Click="BtnDistanceDec_Click"/>
                                <Button Grid.Column="3" Content="►" Style="{StaticResource Win10ClassicButton}" Padding="0" FontSize="9" Click="BtnDistanceInc_Click"/>
                            </Grid>

                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rotate:" VerticalAlignment="Center" FontSize="11.5"/>
                                <TextBox Grid.Column="1" Text="270" Style="{StaticResource Win10TextBox}" IsReadOnly="True" HorizontalContentAlignment="Right" Margin="0,0,2,0"/>
                                <Button Grid.Column="2" Content="◄" Style="{StaticResource Win10ClassicButton}" Padding="0" FontSize="9" Click="BtnResetMapCamera_Click"/>
                                <Button Grid.Column="3" Content="►" Style="{StaticResource Win10ClassicButton}" Padding="0" FontSize="9" Click="BtnResetMapCamera_Click"/>
                            </Grid>

                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Lighting:" VerticalAlignment="Center" FontSize="11.5"/>
                                <TextBox Grid.Column="1" x:Name="TxtSidebarLighting" Text="Noon" Style="{StaticResource Win10TextBox}" IsReadOnly="True" Margin="0,0,2,0"/>
                                <Button Grid.Column="2" Content="◄" Style="{StaticResource Win10ClassicButton}" Padding="0" FontSize="9"/>
                                <Button Grid.Column="3" Content="►" Style="{StaticResource Win10ClassicButton}" Padding="0" FontSize="9"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Inspector del Elemento Seleccionado en el Mapa -->
                    <Border Grid.Row="3" Background="{DynamicResource Win10SidebarGray}" Padding="6">
                        <Border Background="{DynamicResource Win10WindowBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="OBJETO SELECCIONADO EN MAPA" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSelectedMapEntityTitle" Text="Ninguno (Haz clic en el mapa)" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtSelectedMapEntityVar" Text="Var: -" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtSelectedMapEntityPos" Text="Pos: -" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtSelectedMapEntityOwner" Text="Dueño: -" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" Margin="0,0,0,6"/>

                                    <!-- Editor Rápido de Propiedades (Unidades / Doodads en 3D) -->
                                    <StackPanel x:Name="PnlSelectedEntityEditor" Visibility="Collapsed" Margin="0,0,0,6">
                                        <StackPanel x:Name="PnlUnitOwnerRow" Margin="0,0,0,4">
                                            <TextBlock Text="Dueño (Player):" FontSize="10.5" Foreground="{DynamicResource Win10Text}"/>
                                            <ComboBox x:Name="CmbSelectedEntityOwner" FontSize="11" Padding="4,2" SelectionChanged="CmbSelectedEntityOwner_SelectionChanged"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="2"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Ángulo (°):" FontSize="10.5" Foreground="{DynamicResource Win10Text}"/>
                                                <TextBox x:Name="TxtSelectedEntityAngle" Style="{StaticResource Win10TextBox}" Padding="3,1" FontSize="11"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="⟲" Width="24" Height="22" VerticalAlignment="Bottom" Style="{StaticResource Win10ClassicButton}" ToolTip="Rotar -45°" Click="BtnRotateEntityLeft_Click"/>
                                            <Button Grid.Column="4" Content="⟳" Width="24" Height="22" VerticalAlignment="Bottom" Style="{StaticResource Win10ClassicButton}" ToolTip="Rotar +45°" Click="BtnRotateEntityRight_Click"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Escala:" FontSize="10.5" Foreground="{DynamicResource Win10Text}"/>
                                                <TextBox x:Name="TxtSelectedEntityScale" Style="{StaticResource Win10TextBox}" Padding="3,1" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="LblSelectedEntityHp" Text="Vida (% / -1):" FontSize="10.5" Foreground="{DynamicResource Win10Text}"/>
                                                <TextBox x:Name="TxtSelectedEntityHp" Style="{StaticResource Win10TextBox}" Padding="3,1" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid x:Name="PnlUnitExtraRow" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Maná (-1=def):" FontSize="10.5" Foreground="{DynamicResource Win10Text}"/>
                                                <TextBox x:Name="TxtSelectedEntityMp" Style="{StaticResource Win10TextBox}" Padding="3,1" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Nivel Héroe:" FontSize="10.5" Foreground="{DynamicResource Win10Text}"/>
                                                <TextBox x:Name="TxtSelectedEntityLevel" Style="{StaticResource Win10TextBox}" Padding="3,1" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="PnlDoodadVarRow" Visibility="Collapsed" Margin="0,0,0,4">
                                            <TextBlock Text="Variación (0..N):" FontSize="10.5" Foreground="{DynamicResource Win10Text}"/>
                                            <TextBox x:Name="TxtSelectedEntityVariation" Style="{StaticResource Win10TextBox}" Padding="3,1" FontSize="11"/>
                                        </StackPanel>

                                        <UniformGrid Columns="2" Margin="0,2,0,2">
                                            <Button Height="23" Style="{StaticResource Win10ClassicButton}" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" Foreground="{DynamicResource ThemeSuccessText}" Margin="0,0,2,0" Click="BtnApplyEntityProps_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="pack://application:,,,/Assets/Icons/apply.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Aplicar" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Height="23" Style="{StaticResource Win10ClassicButton}" Background="{DynamicResource ThemeDangerBg}" BorderBrush="{DynamicResource ThemeDangerBorder}" Foreground="{DynamicResource ThemeDangerText}" Margin="2,0,0,0" Click="BtnDeleteSelectedEntity_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="pack://application:,,,/Assets/Icons/delete.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Eliminar" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>

                                    <Button Style="{StaticResource Win10ClassicButton}"
                                            Margin="0,0,0,4"
                                            Click="BtnOpenSelectedUnitInF6_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/objects.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                            <TextBlock Text="Abrir en Object Editor (F6)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Win10ClassicButton}"
                                            Click="BtnCopySelectedJassVar_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/copy.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                            <TextBlock Text="Copiar Variable gg_unit_..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>

            <!-- ÁREA PRINCIPAL (SIN PESTAÑAS REDUNDANTES - CONTROLADA DESDE LA BARRA DE HERRAMIENTAS) -->
            <TabControl Grid.Column="2" x:Name="MainWorkspaceTabs"
                        Background="{DynamicResource Win10WindowBg}"
                        BorderBrush="{DynamicResource Win10Border}"
                        BorderThickness="0" Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- ==================== PESTAÑA 1: EL MAPA EN SÍ + FLOATING TOOL PALETTE ==================== -->
                <TabItem x:Name="TabMapViewport" Header=" 🗺️ Mapa del Mundo (Terreno y Unidades) ">
                    <Grid Background="#202020">
                        <!-- Lienzo 3D Oficial con Modelos, Animaciones y Terreno WebGL (mdx-m3-viewer) -->
                        <controls:WorldMap3DViewportControl x:Name="Map3DViewport" Visibility="Visible" />

                        <!-- Lienzo interactivo 2D del Mapa (Esquemático rápido) -->
                        <controls:WorldMapViewport x:Name="MapViewport" Visibility="Collapsed" />

                        <!-- VENTANA FLOTANTE CLÁSICA "Tool Palette" (Adaptable al tema activo) -->
                        <Border x:Name="FloatingToolPalette"
                                Width="245"
                                Height="540"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,12,18,12"
                                Background="{DynamicResource Win10WindowBg}"
                                BorderBrush="{DynamicResource Win10Border}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Barra de título estilo ventana Windows 10 -->
                                <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="8,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="pack://application:,,,/Assets/Icons/terrain.png" Width="14" Height="14" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="Tool Palette" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Win10Text}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Width="22" Height="20" Background="Transparent" BorderThickness="0"
                                                Click="MenuToggleToolPalette_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Selectores de Paleta (Unit / Doodad / Region / Terrain Palette) -->
                                <StackPanel Grid.Row="1" Margin="8,8,8,4">
                                    <ComboBox x:Name="CmbPaletteMode" SelectedIndex="0" Margin="0,0,0,5" SelectionChanged="CmbPaletteMode_SelectionChanged">
                                        <ComboBoxItem Content="Unit Palette (Unidades en Mapa)"/>
                                        <ComboBoxItem Content="Doodad Palette (Árboles y Decoración)"/>
                                        <ComboBoxItem Content="Region Palette (Regiones / Rects)"/>
                                        <ComboBoxItem Content="Terrain Palette (Terreno y Precipicios)"/>
                                    </ComboBox>

                                    <!-- Modo de interacción 3D + Fuente de lista (Colocadas vs Catálogo) -->
                                    <StackPanel x:Name="PnlUnitDoodadModeControls" Margin="0,0,0,5">
                                        <UniformGrid Columns="2" Margin="0,0,0,4">
                                            <ToggleButton x:Name="TglModeSelect" IsChecked="True" Height="24" FontSize="11" Margin="0,0,2,0" Click="BtnEntityToolMode_Click" Tag="select">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="pack://application:,,,/Assets/Icons/mode_select.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Seleccionar" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton x:Name="TglModePlace" IsChecked="False" Height="24" FontSize="11" Margin="2,0,0,0" Click="BtnEntityToolMode_Click" Tag="place">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="pack://application:,,,/Assets/Icons/mode_place.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Colocar en 3D" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ToggleButton>
                                        </UniformGrid>

                                        <ComboBox x:Name="CmbPaletteSource" SelectedIndex="0" Margin="0,0,0,4" FontSize="11" SelectionChanged="CmbPaletteSource_SelectionChanged">
                                            <ComboBoxItem Content="En el Mapa (Colocadas)"/>
                                            <ComboBoxItem Content="Catálogo para Colocar (Base + Custom)"/>
                                        </ComboBox>

                                        <ComboBox x:Name="CmbPlaceOwner" SelectedIndex="0" FontSize="11" ToolTip="Dueño de la unidad al colocar en el mapa" SelectionChanged="CmbPlaceOwner_SelectionChanged"/>
                                    </StackPanel>

                                    <TextBox x:Name="TxtPaletteFilter"
                                             Style="{StaticResource Win10TextBox}"
                                             ToolTip="Filtrar por nombre o rawcode..."
                                             Margin="0,0,0,6"
                                             TextChanged="TxtPaletteFilter_TextChanged"/>

                                    <!-- Botones verdes clásicos de selección/rotación de la Tool Palette -->
                                    <StackPanel x:Name="PnlPaletteActions" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Width="76" Height="26" Style="{StaticResource Win10ClassicButton}" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" Foreground="{DynamicResource ThemeSuccessText}" Margin="0,0,4,0" Click="BtnPaletteCenterSelected_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/Assets/Icons/center.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                                <TextBlock Text="Centrar" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="76" Height="26" Style="{StaticResource Win10ClassicButton}" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" Foreground="{DynamicResource ThemeSuccessText}" Margin="0,0,4,0" Click="BtnResetMapCamera_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/Assets/Icons/fit_all.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                                <TextBlock Text="Ver Todo" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="64" Height="26" Style="{StaticResource Win10ClassicButton}" Click="BtnOpenSelectedUnitInF6_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/Assets/Icons/objects.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                                <TextBlock Text="En F6" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Lista de Elementos de la Paleta -->
                                <ListBox Grid.Row="2"
                                         x:Name="LstToolPalette"
                                         Margin="8,0,8,6"
                                         Background="{DynamicResource ThemeInputBg}"
                                         Foreground="{DynamicResource Win10Text}"
                                         BorderBrush="{DynamicResource Win10Border}"
                                         BorderThickness="1"
                                         FontSize="11.5"
                                         DisplayMemberPath="PaletteDisplay"
                                         SelectionChanged="LstToolPalette_SelectionChanged"/>

                                <!-- Panel Clásico de Terreno y Precipicios (Apply Texture / Apply Cliff / Apply Height) -->
                                <ScrollViewer Grid.Row="2"
                                              x:Name="PnlTerrainPalette"
                                              Visibility="Collapsed"
                                              Margin="8,0,8,6"
                                              VerticalScrollBarVisibility="Auto"
                                              Foreground="{DynamicResource Win10Text}">
                                    <StackPanel>
                                        <!-- 1. Apply Texture -->
                                        <CheckBox x:Name="ChkApplyTexture"
                                                  Content="Apply Texture"
                                                  FontSize="11.5"
                                                  FontWeight="SemiBold"
                                                  Foreground="{DynamicResource Win10Text}"
                                                  Checked="TerrainOption_Changed"
                                                  Unchecked="TerrainOption_Changed"/>
                                        <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Margin="14,3,0,4" Padding="4">
                                            <WrapPanel x:Name="WpTerrainTextures"/>
                                        </Border>
                                        <CheckBox x:Name="ChkApplyBlight"
                                                  Content="Blight (Tierra Maldita)"
                                                  Margin="14,0,0,7"
                                                  FontSize="11"
                                                  Foreground="{DynamicResource Win10Text}"
                                                  Checked="TerrainOption_Changed"
                                                  Unchecked="TerrainOption_Changed"/>

                                        <!-- 2. Apply Cliff (Decrease, Same, Increase, Water, Ramp) -->
                                        <CheckBox x:Name="ChkApplyCliff"
                                                  Content="Apply Cliff: NONE"
                                                  FontSize="11.5"
                                                  FontWeight="SemiBold"
                                                  Foreground="{DynamicResource Win10Text}"
                                                  Checked="TerrainOption_Changed"
                                                  Unchecked="TerrainOption_Changed"/>
                                        <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Margin="14,3,0,7" Padding="4">
                                            <StackPanel>
                                                <UniformGrid Columns="3" Margin="0,0,0,3">
                                                    <ToggleButton x:Name="BtnCliffDec" Tag="DecreaseOne" Height="24" Margin="1" FontSize="10.5" Content="▼ Bajar" ToolTip="Decrease One (Bajar precipicio 1 nivel)" Click="BtnCliffTool_Click"/>
                                                    <ToggleButton x:Name="BtnCliffSame" Tag="SameLevel" Height="24" Margin="1" FontSize="10.5" Content="═ Nivel" ToolTip="Same Level (Mantener altura del acantilado)" Click="BtnCliffTool_Click"/>
                                                    <ToggleButton x:Name="BtnCliffInc" Tag="IncreaseOne" Height="24" Margin="1" FontSize="10.5" Content="▲ Subir" ToolTip="Increase One (Subir precipicio 1 nivel)" Click="BtnCliffTool_Click"/>
                                                </UniformGrid>
                                                <UniformGrid Columns="2">
                                                    <ToggleButton x:Name="BtnCliffWater" Tag="Water" Height="24" Margin="1" FontSize="10.5" ToolTip="Water (Crear cuenca de agua)" Click="BtnCliffTool_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="pack://application:,,,/Assets/Icons/terrain_water.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Agua" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <ToggleButton x:Name="BtnCliffRamp" Tag="Ramp" Height="24" Margin="1" FontSize="10.5" FontWeight="SemiBold" ToolTip="Ramp (Rampa / Precipicio transitable entre niveles)" Click="BtnCliffTool_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="pack://application:,,,/Assets/Icons/terrain_ramp.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Rampa" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. Apply Height (Idéntico al W3 World Editor clásico: Raise, Lower, Plateau, Noise, Smooth) -->
                                        <CheckBox x:Name="ChkApplyHeight"
                                                  Content="Apply Height: NONE"
                                                  FontSize="11.5"
                                                  FontWeight="SemiBold"
                                                  Foreground="{DynamicResource Win10Text}"
                                                  Checked="TerrainOption_Changed"
                                                  Unchecked="TerrainOption_Changed"/>
                                        <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Margin="14,3,0,5" Padding="3">
                                            <UniformGrid Columns="5">
                                                <!-- Raise -->
                                                <ToggleButton x:Name="BtnHeightRaise" Tag="Raise" Height="32" Margin="1" ToolTip="Raise (Elevar terreno)" Click="BtnHeightTool_Click">
                                                    <Viewbox Width="24" Height="20">
                                                        <Canvas Width="28" Height="22">
                                                            <Polygon Points="2,13 14,7 26,13 14,20" Fill="#3B79C9" Stroke="#123059" StrokeThickness="1"/>
                                                            <Path Data="M 6,13 Q 14,1 22,13 Z" Fill="#88BDF8" Stroke="#123059" StrokeThickness="1"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </ToggleButton>
                                                <!-- Lower -->
                                                <ToggleButton x:Name="BtnHeightLower" Tag="Lower" Height="32" Margin="1" ToolTip="Lower (Hundir terreno)" Click="BtnHeightTool_Click">
                                                    <Viewbox Width="24" Height="20">
                                                        <Canvas Width="28" Height="22">
                                                            <Polygon Points="2,10 14,4 26,10 14,17" Fill="#4E8DDA" Stroke="#123059" StrokeThickness="1"/>
                                                            <Ellipse Width="12" Height="7" Fill="#102C4D" Canvas.Left="8" Canvas.Top="7.5"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </ToggleButton>
                                                <!-- Plateau -->
                                                <ToggleButton x:Name="BtnHeightPlateau" Tag="Plateau" Height="32" Margin="1" ToolTip="Plateau (Meseta plana)" Click="BtnHeightTool_Click">
                                                    <Viewbox Width="24" Height="20">
                                                        <Canvas Width="28" Height="22">
                                                            <Polygon Points="2,13 14,7 26,13 14,20" Fill="#3B79C9" Stroke="#123059" StrokeThickness="1"/>
                                                            <Path Data="M 8,10 L 8,13 A 6,3 0 0,0 20,13 L 20,10 Z" Fill="#153763" Stroke="#123059" StrokeThickness="0.8"/>
                                                            <Ellipse Canvas.Left="8" Canvas.Top="7" Width="12" Height="6" Fill="#78B2F5" Stroke="#123059" StrokeThickness="0.9"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </ToggleButton>
                                                <!-- Noise -->
                                                <ToggleButton x:Name="BtnHeightNoise" Tag="Noise" Height="32" Margin="1" ToolTip="Noise (Relieve irregular / Ruido)" Click="BtnHeightTool_Click">
                                                    <Viewbox Width="24" Height="20">
                                                        <Canvas Width="28" Height="22">
                                                            <Polygon Points="2,13 14,7 26,13 14,20" Fill="#4E8DDA" Stroke="#123059" StrokeThickness="1"/>
                                                            <Polyline Points="5,13 8,4 11,12 14,2 17,12 20,5 22,13" Fill="#7CB4F6" Stroke="#123059" StrokeThickness="1"/>
                                                            <Path Data="M 21,3 L 26,8 M 26,8 L 23,8 M 26,8 L 26,5" Stroke="#111111" StrokeThickness="1.5"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </ToggleButton>
                                                <!-- Smooth -->
                                                <ToggleButton x:Name="BtnHeightSmooth" Tag="Smooth" Height="32" Margin="1" ToolTip="Smooth (Suavizar terreno)" Click="BtnHeightTool_Click">
                                                    <Viewbox Width="24" Height="20">
                                                        <Canvas Width="28" Height="22">
                                                            <Ellipse Canvas.Left="4" Canvas.Top="9" Width="20" Height="10" Fill="#3B79C9" Stroke="#123059" StrokeThickness="1"/>
                                                            <Path Data="M 7,13 Q 14,4 21,13" Fill="#7DB6F7" Stroke="#123059" StrokeThickness="1"/>
                                                            <Path Data="M 24,2 L 24,8 M 22,6 L 24,8.5 L 26,6" Stroke="#111111" StrokeThickness="1.5"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </ToggleButton>
                                            </UniformGrid>
                                        </Border>

                                        <TextBlock Text="Clic Izq: Aplicar pincel | Ctrl+Clic: Rotar vista | Esc: Cámara"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource ThemeTextMuted}"
                                                   TextWrapping="Wrap"
                                                   Margin="2,2,2,0"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Sección inferior Size: 1..8 y Shape: Circle / Square -->
                                <StackPanel Grid.Row="3" Margin="8,0,8,8">
                                    <TextBlock x:Name="TxtBrushSizeLabel" Text="Size: 2" FontSize="11" Foreground="{DynamicResource Win10Text}" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button x:Name="BtnSize1" Tag="1" Content="•" Width="28" Height="24" Style="{StaticResource Win10ClassicButton}" Margin="0,0,3,0" Click="BtnBrushSize_Click"/>
                                        <Button x:Name="BtnSize2" Tag="2" Content="●" Width="28" Height="24" Style="{StaticResource Win10ClassicButton}" Margin="0,0,3,0" FontSize="9" Click="BtnBrushSize_Click"/>
                                        <Button x:Name="BtnSize3" Tag="3" Content="●" Width="28" Height="24" Style="{StaticResource Win10ClassicButton}" Margin="0,0,3,0" FontSize="12" Click="BtnBrushSize_Click"/>
                                        <Button x:Name="BtnSize5" Tag="5" Content="⬤" Width="28" Height="24" Style="{StaticResource Win10ClassicButton}" Margin="0,0,3,0" Click="BtnBrushSize_Click"/>
                                        <Button x:Name="BtnSize8" Tag="8" Content="⬛" Width="28" Height="24" Style="{StaticResource Win10ClassicButton}" Click="BtnBrushSize_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtBrushShapeLabel" Text="Shape: Circle" FontSize="11" Foreground="{DynamicResource Win10Text}" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnShapeCircle" Tag="Circle" Content="●" Width="28" Height="24" Style="{StaticResource Win10ClassicButton}" Margin="0,0,3,0" Click="BtnBrushShape_Click"/>
                                        <Button x:Name="BtnShapeSquare" Tag="Square" Content="■" Width="28" Height="24" Style="{StaticResource Win10ClassicButton}" Click="BtnBrushShape_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ==================== PESTAÑA 2: TRIGGER EDITOR (F4) (ABRE EN VENTANA FLOTANTE COMO WARCRAFT III) ==================== -->
                <TabItem x:Name="TabTriggers" Visibility="Collapsed">
                    <Grid Background="{DynamicResource Win10WindowBg}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Árbol de Triggers y Categorías WTG/WCT -->
                        <Grid Grid.Column="0" Background="{DynamicResource Win10WindowBg}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="6,4">
                                <DockPanel>
                                    <TextBlock Text="Filtrar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtTreeFilter" Style="{StaticResource Win10TextBox}" TextChanged="TxtTreeFilter_TextChanged"/>
                                </DockPanel>
                            </Border>

                            <TreeView Grid.Row="1"
                                      x:Name="TreeTriggers"
                                      Background="{DynamicResource ThemeInputBg}"
                                      Foreground="{DynamicResource Win10Text}"
                                      BorderThickness="0"
                                      SelectedItemChanged="TreeTriggers_SelectedItemChanged">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                        <Setter Property="Padding" Value="2,1"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Win10Text}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="1">
                                            <Image Source="{Binding IconUri}" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>

                        <!-- Editor de Código vJASS + Consola JassHelper Inferior -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="155"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="8,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox x:Name="TxtCodeSearch" Width="160" Style="{StaticResource Win10TextBox}" KeyDown="TxtCodeSearch_KeyDown"/>
                                        <Button Content="Buscar" Style="{StaticResource Win10ClassicButton}" Margin="4,0,0,0" Click="BtnFindInCode_Click"/>
                                        <Button Content="+ Nuevo Trigger vJASS" Style="{StaticResource Win10ClassicButton}" Margin="6,0,0,0" Click="BtnNewVjassTrigger_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtActiveTriggerTitle" Text="📜 war3map.j" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtActiveTriggerMeta" Text="" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <avalonEdit:TextEditor Grid.Row="1"
                                                   x:Name="CodeEditor"
                                                   FontFamily="Consolas"
                                                   FontSize="13.5"
                                                   Background="#1E1E1E"
                                                   Foreground="#E6EDF3"
                                                   ShowLineNumbers="True"
                                                   LineNumbersForeground="#858585"
                                                   HorizontalScrollBarVisibility="Auto"
                                                   VerticalScrollBarVisibility="Auto"
                                                   TextChanged="CodeEditor_TextChanged"/>

                            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>

                            <DataGrid Grid.Row="3"
                                      x:Name="GridDiagnostics"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      MouseDoubleClick="GridDiagnostics_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="" Binding="{Binding SeverityIcon}" Width="32"/>
                                    <DataGridTextColumn Header="Severidad" Binding="{Binding Severity}" Width="75"/>
                                    <DataGridTextColumn Header="Herramienta" Binding="{Binding Source}" Width="115"/>
                                    <DataGridTextColumn Header="Archivo / Trigger" Binding="{Binding TriggerOrFile}" Width="170"/>
                                    <DataGridTextColumn Header="Línea" Binding="{Binding DisplayLine}" Width="80"/>
                                    <DataGridTextColumn Header="Mensaje de Compilación (Doble clic para saltar a la línea)" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ==================== PESTAÑA 3: OBJECT EDITOR (F6) (ABRE EN VENTANA FLOTANTE COMO WARCRAFT III) ==================== -->
                <TabItem x:Name="TabObjects" Visibility="Collapsed">
                    <controls:ObjectEditorView x:Name="EmbeddedObjectEditor" />
                </TabItem>

                <!-- ==================== PESTAÑA 4: IMPORT MANAGER (F12) ==================== -->
                <TabItem x:Name="TabImports" Header=" 📦 Import Manager (F12) ">
                    <Grid Background="{DynamicResource Win10WindowBg}" AllowDrop="True" Drop="ImportsGrid_Drop" DragOver="ImportsGrid_DragOver">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="8,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Filtrar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtImportFilter" Width="200" Style="{StaticResource Win10TextBox}" TextChanged="TxtImportFilter_TextChanged"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Win10ClassicButton}" Margin="0,0,4,0" Click="BtnImportFiles_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/add.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Import File(s)..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Win10ClassicButton}" Margin="0,0,4,0" Click="BtnExportSelectedFile_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/export_file.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Export File..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Win10ClassicButton}" Margin="0,0,4,0" Click="BtnExportAllFiles_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/open.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Export All Files..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Win10ClassicButton}" Click="BtnDeleteImportedFile_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/delete.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Delete File" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="GridImports" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Full Path in MPQ" Binding="{Binding MpqPath, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="File Type" Binding="{Binding FileCategory}" Width="210" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ==================== PESTAÑA 5: VARIABLES GLOBALES (1,836) Y BÚSQUEDA GLOBAL ==================== -->
                <TabItem x:Name="TabGlobalSearch" Header=" 📊 Variables Globales (WTG) &amp; Búsqueda Global ">
                    <Grid Background="{DynamicResource Win10WindowBg}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tabla de las 1,836 Variables Globales de war3map.wtg -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="8,0">
                                <DockPanel>
                                    <TextBlock Text="Variables WTG (udg_*):" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtVarFilter" Style="{StaticResource Win10TextBox}" TextChanged="TxtVarFilter_TextChanged"/>
                                </DockPanel>
                            </Border>
                            <DataGrid Grid.Row="1" x:Name="GridGlobalVars" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Identificador JASS" Binding="{Binding JassIdentifier}" Width="190" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="95"/>
                                    <DataGridTextColumn Header="Array" Binding="{Binding ArrayDisplay}" Width="70"/>
                                    <DataGridTextColumn Header="Valor Inicial" Binding="{Binding InitialValue}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>

                        <!-- Buscador Global en Todo el Mapa -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Buscar en todo el mapa:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtGlobalSearchQuery" Width="260" Style="{StaticResource Win10TextBox}" KeyDown="TxtGlobalSearchQuery_KeyDown"/>
                                    <Button Style="{StaticResource Win10ClassicButton}" Margin="6,0,0,0" Click="BtnExecuteGlobalSearch_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/Icons/search.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Buscar" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="TxtGlobalSearchCount" Text="" Foreground="{DynamicResource ThemeAccentText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <DataGrid Grid.Row="1"
                                      x:Name="GridGlobalSearchResults"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      MouseDoubleClick="GridGlobalSearchResults_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Módulo" Binding="{Binding Source}" Width="120"/>
                                    <DataGridTextColumn Header="Trigger / Objeto" Binding="{Binding TriggerOrFile}" Width="210"/>
                                    <DataGridTextColumn Header="Línea" Binding="{Binding DisplayLine}" Width="75"/>
                                    <DataGridTextColumn Header="Texto Encontrado" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- 4. BARRA DE ESTADO INFERIOR CLÁSICA WORLD EDITOR (4 Celdas Hundidas Dinámicas) -->
        <Border Grid.Row="3" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,1,0,0" Padding="3,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="6,0" Margin="0,0,3,0">
                    <TextBlock x:Name="TxtStatusCoords" Text="Point: (0.0, 0.0, 0.0)  |  Cliff: 2" Foreground="{DynamicResource Win10Text}" VerticalAlignment="Center" FontSize="11.5"/>
                </Border>

                <Border Grid.Column="1" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="6,0" Margin="0,0,3,0">
                    <TextBlock x:Name="TxtStatusSelected" Text="Selected: Ninguno" Foreground="{DynamicResource Win10Text}" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                </Border>

                <Border Grid.Column="2" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="6,0" Margin="0,0,3,0">
                    <TextBlock x:Name="TxtStatusBarLeft" Text="Esperando mapa..." Foreground="{DynamicResource Win10Text}" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                </Border>

                <Border Grid.Column="3" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="6,0">
                    <TextBlock x:Name="TxtStatusBarRight" Text="JassHelper 1.27b: Listo" Foreground="{DynamicResource Win10Text}" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
