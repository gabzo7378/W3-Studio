<UserControl x:Class="W3Studio.Controls.ObjectEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:W3Studio.Controls"
             mc:Ignorable="d"
             Background="{DynamicResource Win10WindowBg}"
             Foreground="{DynamicResource Win10Text}"
             FontFamily="Segoe UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. BARRA DE HERRAMIENTAS DEL OBJECT EDITOR (F6) -->
        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="6,2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkRawData" Content="Mostrar Datos Crudos (Ctrl+D)" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ChkDisplayOptions_Changed" Unchecked="ChkDisplayOptions_Changed"/>
                    <CheckBox x:Name="ChkOnlyModified" Content="Solo Campos Modificados" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ChkDisplayOptions_Changed" Unchecked="ChkDisplayOptions_Changed"/>
                    <Button x:Name="BtnPopoutWindow" Style="{StaticResource Win10ClassicButton}" Padding="8,2" Click="BtnPopoutWindow_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/popout.png" Width="13" Height="13" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtBtnPopoutWindow" Text="Abrir Ventana Object Editor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnNewObject" Style="{StaticResource Win10ClassicButton}" Margin="0,0,4,0" ToolTip="Crear un nuevo objeto personalizado eligiendo nombre y rawcode" Click="BtnOpenNewObjectDialog_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/add.png" Width="13" Height="13" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtBtnNewObject" Text="Nuevo Objeto..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCloneObject" Style="{StaticResource Win10ClassicButton}" Margin="0,0,4,0" ToolTip="Duplicar el objeto seleccionado con un nuevo Rawcode" Click="BtnCloneObject_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/copy.png" Width="13" Height="13" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtBtnCloneObject" Text="Clonar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDeleteOrResetObject" Style="{StaticResource Win10ClassicButton}" Margin="0,0,4,0" ToolTip="Eliminar objeto personalizado o restaurar todos los campos de un objeto estándar" Click="BtnDeleteOrResetObject_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/delete.png" Width="13" Height="13" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtBtnDeleteObject" Text="Eliminar / Reset" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnResetField" Style="{StaticResource Win10ClassicButton}" Margin="0,0,4,0" ToolTip="Restaurar el campo seleccionado a su valor original del SLK" Click="BtnResetFieldToDefault_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/reset.png" Width="13" Height="13" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtBtnResetField" Text="Restaurar Campo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAutoFillLevels" Style="{StaticResource Win10ClassicButton}" Margin="0,0,8,0" ToolTip="Auto-rellenar todos los niveles de un campo numérico (Habilidades / Mejoras)" Click="BtnAutoFillLevels_Click">
                        <TextBlock x:Name="TxtBtnAutoFill" Text="Auto-Fill Niveles..." VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. LAS 7 PESTAÑAS CLÁSICAS DEL OBJECT EDITOR -->
        <Border Grid.Row="1" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="4,2,4,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabBtnUnits" IsChecked="False" GroupName="ObjCatTabs" Style="{StaticResource {x:Type ToggleButton}}" Padding="9,2" Margin="0,0,2,0" Checked="CategoryTab_Checked" Tag="Units">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/tab_units.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtTabUnits" Text="Unidades" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabBtnItems" IsChecked="True" GroupName="ObjCatTabs" Style="{StaticResource {x:Type ToggleButton}}" Padding="9,2" Margin="0,0,2,0" Checked="CategoryTab_Checked" Tag="Items">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/tab_items.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtTabItems" Text="Objetos" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabBtnDestructables" GroupName="ObjCatTabs" Style="{StaticResource {x:Type ToggleButton}}" Padding="9,2" Margin="0,0,2,0" Checked="CategoryTab_Checked" Tag="Destructables">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/tab_destructables.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtTabDestructables" Text="Destructibles" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabBtnDoodads" GroupName="ObjCatTabs" Style="{StaticResource {x:Type ToggleButton}}" Padding="9,2" Margin="0,0,2,0" Checked="CategoryTab_Checked" Tag="Doodads">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/tab_doodads.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtTabDoodads" Text="Doodads" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabBtnAbilities" GroupName="ObjCatTabs" Style="{StaticResource {x:Type ToggleButton}}" Padding="9,2" Margin="0,0,2,0" Checked="CategoryTab_Checked" Tag="Abilities">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/tab_abilities.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtTabAbilities" Text="Habilidades" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabBtnBuffs" GroupName="ObjCatTabs" Style="{StaticResource {x:Type ToggleButton}}" Padding="9,2" Margin="0,0,2,0" Checked="CategoryTab_Checked" Tag="Buffs">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/tab_buffs.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtTabBuffs" Text="Buffs/Efectos" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabBtnUpgrades" GroupName="ObjCatTabs" Style="{StaticResource {x:Type ToggleButton}}" Padding="9,2" Checked="CategoryTab_Checked" Tag="Upgrades">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/tab_upgrades.png" Width="15" Height="15" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtTabUpgrades" Text="Mejoras" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 3. ÁREA DIVIDIDA: ÁRBOL (Izquierda) | TABLA (Centro) | INSPECTOR Y VISOR 3D (Derecha) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="385"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: BUSCADOR + ÁRBOL JERÁRQUICO -->
            <Grid Grid.Column="0" Background="{DynamicResource ThemeInputBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="5,4">
                    <DockPanel>
                        <Image Source="pack://application:,,,/Assets/Icons/search.png" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblTreeSearch" Text="Buscar:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11.5"/>
                        <TextBox x:Name="TxtTreeSearch"
                                 Style="{StaticResource Win10TextBox}"
                                 ToolTip="Buscar por nombre o rawcode (ej: Flute, afac, hfoo, AHhb...)"
                                 TextChanged="TxtTreeSearch_TextChanged"/>
                    </DockPanel>
                </Border>

                <TreeView Grid.Row="1"
                          x:Name="TreeObjects"
                          Background="{DynamicResource ThemeInputBg}"
                          Foreground="{DynamicResource Win10Text}"
                          BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          SelectedItemChanged="TreeObjects_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Win10Text}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="1">
                                <Image Source="{Binding IconSource}" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>

            <!-- PANEL CENTRAL: CABECERA DEL OBJETO + TABLA CLÁSICA "Name | Value" -->
            <Grid Grid.Column="2" Background="{DynamicResource ThemeInputBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra superior de la tabla Name | Value -->
                <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="0,0,0,1" Padding="8,4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LblFieldFilter" Text="Filtrar propiedad:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11.5"/>
                            <TextBox x:Name="TxtFieldFilter"
                                     Width="185"
                                     Style="{StaticResource Win10TextBox}"
                                     ToolTip="Filtra las filas de la tabla..."
                                     TextChanged="TxtFieldFilter_TextChanged"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Background="#111111" Margin="0,0,8,0">
                                <Image x:Name="ImgSelectedObjectHeader" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSelectedObjectHeaderName" Text="Selecciona un objeto a la izquierda" FontWeight="Bold" FontSize="13"/>
                                <TextBlock x:Name="TxtSelectedObjectHeaderSub" Text="Categoría • Rawcode" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tabla Clásica "Name | Value" de World Editor -->
                <DataGrid Grid.Row="1"
                          x:Name="GridFields"
                          AutoGenerateColumns="False"
                          Background="{DynamicResource ThemeInputBg}"
                          RowHeaderWidth="0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Win10Border}"
                          MouseDoubleClick="GridFields_MouseDoubleClick"
                          PreviewKeyDown="GridFields_PreviewKeyDown"
                          SelectionChanged="GridFields_SelectionChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ThemeSelectedBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeSelectedText}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColFieldName" Header="Campo" Binding="{Binding DisplayFieldTitle}" Width="330" IsReadOnly="True"/>
                        <DataGridTemplateColumn x:Name="ColFieldValue" Header="Valor" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding DisplayValueText}"
                                                   VerticalAlignment="Center"
                                                   Padding="4,2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsPlainValue, Converter={StaticResource BoolToVis}}"/>
                                        <ComboBox ItemsSource="{Binding Choices}"
                                                  DisplayMemberPath="DisplayText"
                                                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  Padding="4,1"
                                                  FontSize="12"
                                                  VerticalContentAlignment="Center"
                                                  Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}"
                                                  SelectionChanged="InlineChoiceComboBox_SelectionChanged"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColFieldStatus" Header="Estado" Binding="{Binding StatusBadge}" Width="95" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Win10Border}"/>

            <!-- PANEL DERECHO: INSPECTOR Y STATS (Arriba con Scroll) + PREVISUALIZADOR 3D FIJO FUERA DEL SCROLLVIEWER (Abajo) -->
            <Grid Grid.Column="4" Background="{DynamicResource Win10WindowBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Background="{DynamicResource Win10WindowBg}" Padding="10,10,10,4" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                    <!-- Grilla 4x3 de Posición de Botón (Command Card) + Datos de Icono/Hotkey -->
                    <TextBlock Text="CARTA DE COMANDO 4x3 (CLIC PARA MOVER BOTÓN X,Y)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <UniformGrid Grid.Column="0" x:Name="GridCommandCard" Columns="4" Rows="3" Width="136" Height="102" Background="#181818" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCardPosInfo" Text="Button Pos: (0, 0)" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtCardHotkeyInfo" Text="Hotkey: -" Margin="0,0,0,4"/>
                                <TextBlock Text="Ruta de Icono (.blp):" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                                <DockPanel Margin="0,2,0,0">
                                    <Button DockPanel.Dock="Right" Content="🎨" Width="26" Height="22" Margin="3,0,0,0" Style="{StaticResource Win10ClassicButton}" ToolTip="Editar o crear con Icon Manager" Click="BtnEditIconInManager_Click"/>
                                    <Button DockPanel.Dock="Right" Content="🔍" Width="26" Height="22" Margin="4,0,0,0" Style="{StaticResource Win10ClassicButton}" ToolTip="Elegir icono desde MPQ o Importaciones con vista previa" Click="BtnBrowseIconInPicker_Click"/>
                                    <TextBox x:Name="TxtPropIconPath" Style="{StaticResource Win10TextBox}" FontSize="11" TextChanged="TxtPropIconPath_TextChanged"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- HUD DE STATS DE COMBATE Y ATRIBUTOS (ESTILO IN-GAME WARCRAFT III) -->
                    <Border x:Name="BorderUnitHudStats"
                            Background="#06070A"
                            BorderBrush="#B89844"
                            BorderThickness="1.5"
                            CornerRadius="4"
                            Padding="9,8"
                            Margin="0,0,0,10"
                            Visibility="Visible">
                        <StackPanel>
                            <!-- BARRA DE EXPERIENCIA ESTILO WARCRAFT III (SOLO HÉROES) -->
                            <Border x:Name="BorderHudXpBar"
                                    Height="21"
                                    Background="#0B070E"
                                    BorderBrush="#C8A850"
                                    BorderThickness="1.5"
                                    CornerRadius="3"
                                    Margin="0,0,0,8"
                                    Visibility="Collapsed">
                                <Grid ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52*"/>
                                        <ColumnDefinition Width="48*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="1.5,0,0,1.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#B818E8" Offset="0"/>
                                                <GradientStop Color="#72009C" Offset="0.5"/>
                                                <GradientStop Color="#3E0058" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock x:Name="TxtHudXpLabel"
                                               Grid.ColumnSpan="2"
                                               Text="Nivel 1 Archmage"
                                               Foreground="#FFFFFF"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- COLUMNA IZQUIERDA: DAMAGE Y ARMOR -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <!-- DAMAGE -->
                                    <DockPanel Margin="0,1,0,8">
                                        <Border x:Name="BorderHudAttackIcon" DockPanel.Dock="Left" Width="44" Height="44" BorderBrush="#A68B4B" BorderThickness="0" CornerRadius="2" Margin="0,0,9,0" Background="Transparent">
                                            <Image x:Name="ImgHudAttack" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtHudDamageTitle" Text="Damage:" Foreground="#FFCC00" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtHudAttackType" Text="(Héroe)" Foreground="#8E8E8E" FontSize="10.5" Margin="4,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtHudDamage" Text="21 - 27" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" Margin="4,1,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- ARMOR -->
                                    <DockPanel Margin="0,0,0,1">
                                        <Border x:Name="BorderHudArmorIcon" DockPanel.Dock="Left" Width="44" Height="44" BorderBrush="#A68B4B" BorderThickness="0" CornerRadius="2" Margin="0,0,9,0" Background="Transparent">
                                            <Image x:Name="ImgHudArmor" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TxtHudArmorTitle" Text="Armor:" Foreground="#FFCC00" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtHudArmorType" Text="(Héroe)" Foreground="#8E8E8E" FontSize="10.5" Margin="4,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="4,1,0,0">
                                                <TextBlock x:Name="TxtHudArmor" Text="0" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtHudArmorBonus" Text="" Foreground="#33FF33" FontSize="12" Margin="4,0,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>

                                <!-- COLUMNA DERECHA: ATRIBUTOS DE HÉROE (SOLO ICONO DEL ATRIBUTO PRINCIPAL + TEXTO) -->
                                <Grid x:Name="GridHeroAttributes"
                                      Grid.Column="1"
                                      Margin="10,0,2,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="BorderHudPrimaryAttr"
                                            Grid.Column="0"
                                            Width="44"
                                            Height="44"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            VerticalAlignment="Center"
                                            Margin="0,0,9,0">
                                        <Image x:Name="ImgHudPrimaryAttr" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtHudStrLabel" Text="Fuerza:" Foreground="#FFCC00" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtHudStr" Text="14" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,3"/>

                                        <TextBlock x:Name="TxtHudAgiLabel" Text="Agilidad:" Foreground="#FFCC00" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtHudAgi" Text="17" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,3"/>

                                        <TextBlock x:Name="TxtHudIntLabel" Text="Inteligencia:" Foreground="#FFCC00" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtHudInt" Text="19" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Tooltip Básico (utip / atp1 / itip):" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtTooltipBasic" Style="{StaticResource Win10TextBox}" Margin="0,2,0,6" TextChanged="TxtTooltipBasic_TextChanged"/>

                    <TextBlock Text="Tooltip Extendido (utub / aub1 / iutp):" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtTooltipExtended"
                             Style="{StaticResource Win10TextBox}"
                             Height="95"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,2,0,8"
                             TextChanged="TxtTooltipExtended_TextChanged"/>

                    <!-- PREVISUALIZADOR EN VIVO ESTILO WARCRAFT III -->
                    <TextBlock Text="PREVISUALIZACIÓN" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,4"/>
                    <Border Background="#0B0E14" BorderBrush="#C8A858" BorderThickness="2" Padding="10" Margin="0,0,0,4">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Width="28" Height="28" BorderBrush="#C8A858" BorderThickness="1" Margin="0,0,8,0">
                                    <Image x:Name="ImgTooltipPreviewIcon" Stretch="Fill"/>
                                </Border>
                                <TextBlock x:Name="TxtPreviewBasic" FontSize="13" FontWeight="SemiBold" Foreground="#F2F2F2" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Rectangle Height="1" Fill="#4A3F20" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtPreviewExtended" FontSize="12" Foreground="#F2F2F2" TextWrapping="Wrap" LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- INSPECTOR 3D DEL MODELO FIJO FUERA DEL SCROLLVIEWER (evita bugs de HwndHost/WebView2 al hacer scroll) -->
                <Border x:Name="Border3DModelSection"
                        Grid.Row="1"
                        Background="#161A22"
                        BorderBrush="#3A4250"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6"
                        Margin="10,4,10,10">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/Icons/model_3d.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                <TextBlock Text="MODELO 3D (ANIMACIONES &amp; EQUIPO)" FontWeight="Bold" FontSize="11" Foreground="#FFCC00" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="BtnToggle3DModelView"
                                    DockPanel.Dock="Right"
                                    Content="Ocultar Visor 3D"
                                    Style="{StaticResource Win10ClassicButton}"
                                    Padding="6,2"
                                    FontSize="10.5"
                                    Click="BtnToggle3DModelView_Click"/>
                            <ComboBox x:Name="CmbModelEffectVariant"
                                      DockPanel.Dock="Right"
                                      Width="128"
                                      Height="21"
                                      Margin="0,0,5,0"
                                      FontSize="10.5"
                                      Visibility="Collapsed"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectionChanged="CmbModelEffectVariant_SelectionChanged"/>
                        </DockPanel>

                        <Border x:Name="Border3DModelContainer"
                                Height="220"
                                Background="#0D0F13"
                                BorderBrush="#252A36"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="0,6,0,0">
                            <controls:MdxModelViewerControl x:Name="MdxModelViewer"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
