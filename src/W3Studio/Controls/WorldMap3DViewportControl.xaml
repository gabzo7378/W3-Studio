<UserControl x:Class="W3Studio.Controls.WorldMap3DViewportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#0F1218">
    <Grid>
        <wv2:WebView2 x:Name="WvMap" DefaultBackgroundColor="#0F1218"/>

        <Border x:Name="BorderInitProgress"
                Background="{DynamicResource Win10PanelBg}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="18,14"
                Width="340"
                CornerRadius="3"
                BorderBrush="{DynamicResource Win10Border}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtInitTitle"
                           Text="Cargando Editor de Terreno..."
                           Foreground="{DynamicResource Win10Text}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <ProgressBar x:Name="PrgInitViewport"
                             Height="14"
                             IsIndeterminate="True"
                             Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtInitDetail"
                           Text="Preparando entorno visual del mapa..."
                           Foreground="{DynamicResource ThemeTextMuted}"
                           FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

