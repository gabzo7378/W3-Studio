<Window x:Class="W3Studio.Controls.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selector de Iconos (.blp / .tga)"
        Icon="pack://application:,,,/Assets/W3Studio.ico"
        Width="940" Height="620" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win10WindowBg}"
        Foreground="{DynamicResource Win10Text}"
        KeyDown="Window_KeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Seleccionar Icono" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="Explora iconos base de Warcraft III e importaciones del mapa con verificación DISBTN" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/>
                </StackPanel>
                <TextBlock x:Name="TxtCount" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentText}"/>
            </DockPanel>
        </Border>

        <!-- Contenido: [Lista con miniaturas y rutas | Vista previa + Verificación DISBTN] -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo -->
            <Border Grid.Column="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <DockPanel Margin="0,0,0,5">
                            <Button DockPanel.Dock="Right"
                                    Content="✕"
                                    Width="26"
                                    Height="23"
                                    Margin="5,0,0,0"
                                    Padding="0"
                                    Style="{StaticResource Win10ClassicButton}"
                                    ToolTip="Limpiar búsqueda y filtros"
                                    Click="BtnClearFilters_Click"/>
                            <TextBox x:Name="TxtSearch"
                                     Style="{StaticResource Win10TextBox}"
                                     ToolTip="Buscar por archivo, ruta o nombre de unidad/habilidad (ej: Paladin, HolyBolt, Sword...)"
                                     TextChanged="Filter_Changed"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" x:Name="CmbCategory" SelectedIndex="0" FontSize="11" SelectionChanged="Filter_Changed" ToolTip="Filtrar por tipo de icono">
                                <ComboBoxItem Content="Activos / Pasivos (sin DIS)" Tag="NoDis"/>
                                <ComboBoxItem Content="Solo Activos (BTN)" Tag="Btn"/>
                                <ComboBoxItem Content="Solo Pasivos (PAS)" Tag="Pas"/>
                                <ComboBoxItem Content="Solo Autocast (ATC)" Tag="Atc"/>
                                <ComboBoxItem Content="Solo Deshabilitados (DIS)" Tag="Dis"/>
                                <ComboBoxItem Content="InfoCard / UI" Tag="Ui"/>
                                <ComboBoxItem Content="Importados del Mapa" Tag="Imported"/>
                                <ComboBoxItem Content="Todos (incluyendo DIS)" Tag="All"/>
                            </ComboBox>

                            <ComboBox Grid.Column="2" x:Name="CmbRace" SelectedIndex="0" FontSize="11" SelectionChanged="Filter_Changed" ToolTip="Filtrar por raza">
                                <ComboBoxItem Content="Todas las razas" Tag="All"/>
                                <ComboBoxItem Content="Humanos" Tag="Human"/>
                                <ComboBoxItem Content="Orcos" Tag="Orc"/>
                                <ComboBoxItem Content="Muertos Vivientes" Tag="Undead"/>
                                <ComboBoxItem Content="Elfos Nocturnos" Tag="NightElf"/>
                                <ComboBoxItem Content="Neutrales / Creeps" Tag="Neutral"/>
                                <ComboBoxItem Content="Otros / Sin raza" Tag="Other"/>
                            </ComboBox>

                            <ComboBox Grid.Column="4" x:Name="CmbUsage" SelectedIndex="0" FontSize="11" SelectionChanged="Filter_Changed" ToolTip="Filtrar por categoría">
                                <ComboBoxItem Content="Todas categorías" Tag="All"/>
                                <ComboBoxItem Content="Héroes" Tag="Heroes"/>
                                <ComboBoxItem Content="Unidades" Tag="Units"/>
                                <ComboBoxItem Content="Edificios" Tag="Buildings"/>
                                <ComboBoxItem Content="Habilidades / Buffs" Tag="Abilities"/>
                                <ComboBoxItem Content="Objetos (Items)" Tag="Items"/>
                                <ComboBoxItem Content="Mejoras (Upgrades)" Tag="Upgrades"/>
                                <ComboBoxItem Content="Otros / UI" Tag="Other"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             x:Name="LstIcons"
                             Background="{DynamicResource ThemeInputBg}"
                             Foreground="{DynamicResource Win10Text}"
                             BorderBrush="{DynamicResource Win10Border}"
                             BorderThickness="1"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="LstIcons_SelectionChanged"
                             MouseDoubleClick="LstIcons_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <Image DockPanel.Dock="Left" Source="{Binding PreviewBitmap}" Width="36" Height="36" Stretch="Fill" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border DockPanel.Dock="Right" Background="{Binding BadgeBg}" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding SourceBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{Binding MpqPath}" FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Panel derecho: Previsualización y Verificaciones -->
            <Border Grid.Column="2" Background="#0E121A" BorderBrush="#C8A858" BorderThickness="1.5" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PREVISUALIZACIÓN Y VERIFICACIÓN" FontWeight="Bold" FontSize="11.5" Foreground="#FFCC00" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="ICONO (64x64)" Foreground="#FFCC00" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <Border Background="#000000" Width="96" Height="96">
                                    <Image x:Name="ImgPreviewMain" Width="96" Height="96" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="DISBTN" Foreground="#CCCCCC" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <Border Background="#000000" Width="96" Height="96">
                                    <Image x:Name="ImgPreviewDis" Width="96" Height="96" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Background="#151B26" BorderBrush="#2E3748" BorderThickness="1" CornerRadius="3" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="TxtVerifyMain" FontSize="11" FontWeight="SemiBold" Text="✓ Icono verificado"/>
                                <TextBlock x:Name="TxtVerifyDis" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" Text="✓ DISBTN verificado"/>
                                <TextBlock x:Name="TxtDisPathInfo" FontFamily="Consolas" FontSize="10" Foreground="#9BA5B4" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Ruta del Icono:" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSelectedPath"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Padding="5,4"
                                 Background="#090C11"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#3A4250"
                                 TextChanged="TxtSelectedPath_TextChanged"/>

                        <Button x:Name="BtnOpenIconManager"
                                Content="🎨 Abrir en Icon Manager..."
                                Style="{StaticResource Win10ClassicButton}"
                                Margin="0,8,0,0"
                                Padding="8,4"
                                Click="BtnOpenIconManager_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra inferior -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource Win10ClassicButton}" Padding="14,5" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="✓ Elegir Icono" Style="{StaticResource Win10ClassicButton}" Padding="16,5" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" Foreground="{DynamicResource ThemeSuccessText}" FontWeight="Bold" Click="BtnAccept_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

