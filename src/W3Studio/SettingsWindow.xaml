<Window x:Class="W3Studio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración y Preferencias — W3 Studio"
        Icon="pack://application:,,,/Assets/W3Studio.ico"
        Width="680" Height="480"
        MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Win10WindowBg}"
        Foreground="{DynamicResource Win10Text}"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <Image Source="pack://application:,,,/Assets/Icons/settings.png" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Configuración General de W3 Studio" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Win10Text}"/>
                    <TextBlock Text="Ajusta el tema visual, rutas de Warcraft III, opciones de prueba y preferencias del editor." Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CUERPO PRINCIPAL CON PESTAÑAS LATERALES -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú de categorías a la izquierda -->
            <Border Grid.Column="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3">
                <ListBox x:Name="LstCategories" SelectedIndex="0" Background="Transparent" BorderThickness="0" SelectionChanged="LstCategories_SelectionChanged">
                    <ListBoxItem x:Name="CatItemThemes" Padding="10,8" FontSize="12.5" FontWeight="SemiBold">🎨 Temas e Idioma</ListBoxItem>
                    <ListBoxItem x:Name="CatItemWar3" Padding="10,8" FontSize="12.5" FontWeight="SemiBold">🎮 Warcraft III &amp; Pruebas</ListBoxItem>
                    <ListBoxItem x:Name="CatItemEditor" Padding="10,8" FontSize="12.5" FontWeight="SemiBold">🛠️ Editor y Preferencias</ListBoxItem>
                </ListBox>
            </Border>

            <!-- Contenido dinámico a la derecha -->
            <Border Grid.Column="2" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="14">
                <Grid>
                    <!-- SECCIÓN 1: TEMAS Y APARIENCIA -->
                    <ScrollViewer x:Name="SecTheme" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="LblLanguageTitle" Text="Idioma del Editor:" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LblLanguageDesc" Text="Cambia el idioma de los campos del Editor de Objetos, menús y herramientas (sin mezclar dos idiomas)." Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <ComboBox x:Name="CmbAppLanguage" Height="28" Margin="0,0,0,14" VerticalContentAlignment="Center" SelectionChanged="CmbAppLanguage_SelectionChanged">
                                <ComboBoxItem Content="Español" Tag="es"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                            </ComboBox>

                            <TextBlock x:Name="LblThemeTitle" Text="Selecciona el tema de la aplicación:" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LblThemeDesc" Text="El tema se aplicará en tiempo real en la ventana principal, el editor de objetos y todas las herramientas." Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <!-- Modo Sistema -->
                            <Border BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8" Background="{DynamicResource ThemeInputBg}">
                                <RadioButton x:Name="RbThemeSystem" GroupName="Themes" Checked="RbTheme_Checked" Tag="System">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" Background="#808080" BorderBrush="#333333" BorderThickness="1" Margin="4,0,8,0"/>
                                        <Border Width="18" Height="18" Background="#F0F0F0" BorderBrush="#A0A0A0" BorderThickness="1" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Modo Sistema / Clásico World Editor" FontWeight="SemiBold"/>
                                            <TextBlock Text="Gris clásico de Warcraft III 1.27b y Windows clásico." FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Modo Oscuro -->
                            <Border BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8" Background="{DynamicResource ThemeInputBg}">
                                <RadioButton x:Name="RbThemeDark" GroupName="Themes" Checked="RbTheme_Checked" Tag="Dark">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" Background="#1E1E1E" BorderBrush="#555555" BorderThickness="1" Margin="4,0,8,0"/>
                                        <Border Width="18" Height="18" Background="#007ACC" BorderBrush="#005499" BorderThickness="1" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Modo Oscuro (Dark / Midnight)" FontWeight="SemiBold"/>
                                            <TextBlock Text="Ideal para largas sesiones de modding con descansada visual." FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Modo Blanco -->
                            <Border BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8" Background="{DynamicResource ThemeInputBg}">
                                <RadioButton x:Name="RbThemeLight" GroupName="Themes" Checked="RbTheme_Checked" Tag="Light">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" Margin="4,0,8,0"/>
                                        <Border Width="18" Height="18" Background="#0D6EFD" BorderBrush="#0A58CA" BorderThickness="1" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Modo Blanco (Clean Light)" FontWeight="SemiBold"/>
                                            <TextBlock Text="Interfaz clara, moderna y limpia de alto contraste." FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Modo Rosado -->
                            <Border BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8" Background="{DynamicResource ThemeInputBg}">
                                <RadioButton x:Name="RbThemePink" GroupName="Themes" Checked="RbTheme_Checked" Tag="Pink">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" Background="#FFF0F5" BorderBrush="#D88EA5" BorderThickness="1" Margin="4,0,8,0"/>
                                        <Border Width="18" Height="18" Background="#D43F6C" BorderBrush="#9E1B46" BorderThickness="1" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Modo Rosado (Sakura / Rose)" FontWeight="SemiBold"/>
                                            <TextBlock Text="Tonos suaves rosados, pastel y detalles cerezo." FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Modo Verde Oscuro -->
                            <Border BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8" Background="{DynamicResource ThemeInputBg}">
                                <RadioButton x:Name="RbThemeDarkGreen" GroupName="Themes" Checked="RbTheme_Checked" Tag="DarkGreen">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" Background="#0C1811" BorderBrush="#284E38" BorderThickness="1" Margin="4,0,8,0"/>
                                        <Border Width="18" Height="18" Background="#2EA043" BorderBrush="#1E7030" BorderThickness="1" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Modo Verde Oscuro (Fel Orc / Emerald)" FontWeight="SemiBold"/>
                                            <TextBlock Text="Inspirado en la naturaleza profunda de Warcraft y energía vil." FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Modo Azul Oscuro -->
                            <Border BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8" Background="{DynamicResource ThemeInputBg}">
                                <RadioButton x:Name="RbThemeDarkBlue" GroupName="Themes" Checked="RbTheme_Checked" Tag="DarkBlue">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="18" Background="#0A111C" BorderBrush="#233F66" BorderThickness="1" Margin="4,0,8,0"/>
                                        <Border Width="18" Height="18" Background="#3B82F6" BorderBrush="#1D4ED8" BorderThickness="1" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Modo Azul Oscuro (The Frozen Throne)" FontWeight="SemiBold"/>
                                            <TextBlock Text="Inspirado en Rasganorte, el Trono Helado y la Corona de Hielo." FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SECCIÓN 2: WARCRAFT III & PRUEBAS -->
                    <ScrollViewer x:Name="SecWarcraft" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Directorio de Instalación de Warcraft III:" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBlock Text="W3 Studio utiliza este directorio para leer los MPQs del juego y lanzar la prueba de mapas con F9." Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,0,0,8"/>

                            <DockPanel Margin="0,0,0,14">
                                <Button Content="📂 Examinar..." DockPanel.Dock="Right" Width="100" Height="26" Margin="6,0,0,0" Style="{DynamicResource Win10ClassicButton}" Click="BtnBrowseWar3_Click"/>
                                <TextBox x:Name="TxtWar3Path" Style="{DynamicResource Win10TextBox}" Height="26" VerticalContentAlignment="Center" TextChanged="TxtWar3Path_TextChanged"/>
                            </DockPanel>

                            <TextBlock Text="Estado de los Componentes:" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                            <Border BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource ThemeInputBg}" Padding="10,8" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStatusWar3Exe" Text="• Ejecutable (war3.exe / Frozen Throne.exe): Verificando..." Margin="0,2"/>
                                    <TextBlock x:Name="TxtStatusWar3Mpq" Text="• war3.mpq: Verificando..." Margin="0,2"/>
                                    <TextBlock x:Name="TxtStatusWar3xMpq" Text="• War3x.mpq: Verificando..." Margin="0,2"/>
                                    <TextBlock x:Name="TxtStatusWar3PatchMpq" Text="• War3Patch.mpq: Verificando..." Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Opciones de Lanzamiento (F9 - Guardar y Probar):" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkWindowed" Content="Ejecutar Warcraft III en Modo Ventana (-window)" Margin="0,2,0,8" FontWeight="SemiBold"/>
                            
                            <TextBlock Text="Argumentos Adicionales de Lanzamiento:" FontSize="11.5" Margin="0,4,0,2"/>
                            <TextBox x:Name="TxtExtraArgs" Style="{DynamicResource Win10TextBox}" Height="26" VerticalContentAlignment="Center" ToolTip="Parámetros opcionales como -loadfile, -opengl, etc."/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- SECCIÓN 3: EDITOR Y PREFERENCIAS -->
                    <ScrollViewer x:Name="SecEditor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="LblEditorBehaviorTitle" Text="Comportamiento del Editor:" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>

                            <CheckBox x:Name="ChkAutoSaveBeforeTest" Content="Guardar mapa automáticamente antes de Probar (F9)" IsChecked="True" Margin="0,3,0,8"/>
                            <CheckBox x:Name="ChkShowGridByDefault" Content="Mostrar cuadrícula de terreno (Terrain Grid) por defecto" Margin="0,3,0,12"/>

                            <TextBlock x:Name="LblAdvancedViewTitle" Text="Modo Inspector Avanzado (Archivos Internos del Mapa):" FontWeight="Bold" FontSize="13" Margin="0,4,0,4"/>
                            <TextBlock x:Name="LblAdvancedViewWarning" Text="⚠ Por defecto se ocultan los archivos internos del sistema de Warcraft III (war3map.w3e, war3map.wtg, war3map.shd, etc.) para evitar modificaciones accidentales que corrompan el mapa." Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Border BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource ThemeInputBg}" Padding="10,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="LblAdvImportsCat" Text="📦 Gestor de Importaciones (F12)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkShowInternalImports" Content="Mostrar archivos binarios internos del mapa (war3map.w3e, .w3i, .wtg, .doo, .shd, etc.)" Margin="0,0,0,10"/>

                                    <TextBlock x:Name="LblAdvTriggersCat" Text="⚡ Editor de Triggers (F4)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkShowCompiledTriggerScript" Content="Mostrar nodo de script compilado completo (war3map.j) en el árbol de Triggers" Margin="0,0,0,2"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Herramientas de Compilación Integradas:" FontWeight="Bold" FontSize="12" Margin="0,4,0,4"/>
                            <TextBlock Text="W3 Studio cuenta con compilador JassHelper y PJass 100% integrados sin requerir JNGP externo." Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,0,0,8"/>
                            <Border BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource ThemeInputBg}" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="✓ JassHelper CLI Integrado (Tools\clijasshelper.exe)" Foreground="#2EA043" FontWeight="SemiBold" Margin="0,2"/>
                                    <TextBlock Text="✓ PJass Verificador de Sintaxis (Tools\pjass.exe)" Foreground="#2EA043" FontWeight="SemiBold" Margin="0,2"/>
                                    <TextBlock Text="✓ common.j &amp; blizzard.j versión 1.27b Oficial" Foreground="#2EA043" FontWeight="SemiBold" Margin="0,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- PIE DE VENTANA: BOTONES ACEPTAR, CANCELAR, APLICAR -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="Aplicar" DockPanel.Dock="Right" Width="85" Height="26" Margin="6,0,0,0" Style="{DynamicResource Win10ClassicButton}" Click="BtnApply_Click"/>
            <Button Content="Cancelar" DockPanel.Dock="Right" Width="85" Height="26" Margin="6,0,0,0" Style="{DynamicResource Win10ClassicButton}" IsCancel="True"/>
            <Button Content="Aceptar" DockPanel.Dock="Right" Width="85" Height="26" Style="{DynamicResource Win10ClassicButton}" IsDefault="True" Click="BtnOk_Click"/>
        </DockPanel>
    </Grid>
</Window>
