<Window x:Class="W3Studio.IconManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Icon Manager — Editor de Iconos (.blp) estilo Button Manager"
        Icon="pack://application:,,,/Assets/W3Studio.ico"
        Width="1040" Height="690" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win10WindowBg}"
        Foreground="{DynamicResource Win10Text}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra superior de acciones rápidas -->
        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Win10ClassicButton}"
                            Padding="10,4"
                            FontWeight="SemiBold"
                            Background="#E8F2FF"
                            BorderBrush="#2C74C8"
                            Click="BtnImportExternal_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/image_file.png" Width="15" Height="15" Margin="0,0,5,0"/>
                            <TextBlock Text="Importar Imagen (PNG / JPG / TGA / BLP)..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="  o arrastra y suelta cualquier imagen aquí  |  o elige un icono por defecto de Warcraft III:"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{DynamicResource Win10Text}"/>
                </StackPanel>

                <TextBlock x:Name="TxtMapContextBadge"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="#2673C5"
                           Text="Mapa activo"/>
            </DockPanel>
        </Border>

        <!-- Cuerpo Principal: [Lista MPQ WC3 | Vista Previa Central | Controles Button Manager] -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: EXPLORADOR DE ICONOS WC3 / MAPA -->
            <Border Grid.Column="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ICONOS BASE DE WARCRAFT III / MAPA" FontWeight="Bold" FontSize="11" Foreground="#005499" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="1" x:Name="TxtSearchIcons" Style="{StaticResource Win10TextBox}" ToolTip="Filtrar iconos (ej: Paladin, Fire, Sword, BTN...)" Margin="0,0,0,5" TextChanged="TxtSearchIcons_TextChanged"/>
                    <TextBlock Grid.Row="2" x:Name="TxtIconsCount" Text="Cargando lista..." FontSize="10.5" Foreground="#666666" Margin="0,0,0,4"/>
                    <ListBox Grid.Row="3"
                             x:Name="LstWc3Icons"
                             Background="#FFFFFF"
                             Foreground="#111111"
                             BorderBrush="#808080"
                             BorderThickness="1"
                             FontSize="11"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="LstWc3Icons_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- PANEL CENTRAL: VISTA PREVIA EN VIVO (BTN + DISBTN + RUTAS) -->
            <Border Grid.Column="2" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PREVISUALIZACIÓN EN VIVO (64x64 Y AMPLIADO)" FontWeight="Bold" FontSize="11.5" Foreground="#005499" Margin="0,0,0,8"/>

                    <!-- Escenario oscuro estilo HUD de Warcraft III -->
                    <Border Grid.Row="1" Background="#0C0F16" BorderBrush="#C8A858" BorderThickness="1.5" CornerRadius="4" Padding="14">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icono Principal -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtMainPreviewTitle" Text="ICONO PRINCIPAL (BTN)" Foreground="#FFCC00" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Border BorderBrush="#8A7034" BorderThickness="1" Background="#000000" Width="132" Height="132" Padding="1">
                                        <Image x:Name="ImgPreviewMainBig" Width="128" Height="128" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock Text="1:1 (64px): " Foreground="#AAAAAA" FontSize="10.5" VerticalAlignment="Center"/>
                                        <Border BorderBrush="#555555" BorderThickness="1" Background="#000000">
                                            <Image x:Name="ImgPreviewMain64" Width="64" Height="64" Stretch="None"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Icono DISBTN Automático -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" x:Name="PnlDisbtnPreview">
                                    <TextBlock x:Name="TxtDisPreviewTitle" Text="DESHABILITADO (DISBTN)" Foreground="#CCCCCC" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Border BorderBrush="#555555" BorderThickness="1" Background="#000000" Width="132" Height="132" Padding="1">
                                        <Image x:Name="ImgPreviewDisBig" Width="128" Height="128" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock Text="1:1 (64px): " Foreground="#AAAAAA" FontSize="10.5" VerticalAlignment="Center"/>
                                        <Border BorderBrush="#444444" BorderThickness="1" Background="#000000">
                                            <Image x:Name="ImgPreviewDis64" Width="64" Height="64" Stretch="None"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtSourceInfo" Text="Fuente: Sin imagen cargada (elige de la lista o importa una imagen)" Foreground="#B8C0CC" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Nomenclatura y rutas resultantes en el mapa -->
                    <Border Grid.Row="2" Background="#F5F7FA" BorderBrush="#C0C8D4" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="NOMBRE DE ARCHIVO Y RUTAS MPQ RESULTANTES" FontWeight="Bold" FontSize="11" Foreground="#00458B" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nombre base:" Foreground="#111111" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" x:Name="TxtOutputName" Style="{StaticResource Win10TextBox}" Text="CustomIcon01" TextChanged="TxtOutputName_TextChanged"/>
                                <CheckBox Grid.Column="2" x:Name="ChkAutoDisbtn" Content="Crear DISBTN automático" IsChecked="True" VerticalAlignment="Center" Foreground="#111111" Margin="10,0,0,0" Checked="IconOutputOption_Changed" Unchecked="IconOutputOption_Changed"/>
                            </Grid>

                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="📋 Copiar" Style="{StaticResource Win10ClassicButton}" Padding="6,1" FontSize="10.5" Click="BtnCopyMainPath_Click"/>
                                <TextBlock x:Name="TxtMainMpqPath" FontFamily="Consolas" FontSize="11" Foreground="#14491D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DockPanel Margin="0,2" x:Name="PnlDisMpqPath">
                                <TextBlock x:Name="TxtDisMpqPath" FontFamily="Consolas" FontSize="11" Foreground="#555555" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- PANEL DERECHO: OPCIONES DE BORDE, RECUADRO DE COLOR Y AJUSTES -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10">
                <StackPanel>
                    <!-- 1. ESTILO DE BORDE (BTN, PAS, ATC, UPG, INF, NONE) -->
                    <TextBlock Text="1. ESTILO DE BOTÓN (BUTTON MANAGER)" FontWeight="Bold" FontSize="11" Foreground="#005499" Margin="0,0,0,6"/>
                    <UniformGrid Columns="3" Margin="0,0,0,6">
                        <RadioButton x:Name="RbBorderBtn" Content="BTN (Activo)" GroupName="BorderPreset" IsChecked="True" Tag="Btn" Margin="2" Checked="BorderPreset_Changed"/>
                        <RadioButton x:Name="RbBorderPas" Content="PAS (Pasivo)" GroupName="BorderPreset" Tag="Pas" Margin="2" Checked="BorderPreset_Changed"/>
                        <RadioButton x:Name="RbBorderAtc" Content="ATC (Autocast)" GroupName="BorderPreset" Tag="Atc" Margin="2" Checked="BorderPreset_Changed"/>
                        <RadioButton x:Name="RbBorderUpg" Content="UPG (Mejora)" GroupName="BorderPreset" Tag="Upg" Margin="2" Checked="BorderPreset_Changed"/>
                        <RadioButton x:Name="RbBorderInf" Content="INF (InfoCard)" GroupName="BorderPreset" Tag="Inf" Margin="2" Checked="BorderPreset_Changed"/>
                        <RadioButton x:Name="RbBorderNone" Content="Sin Borde" GroupName="BorderPreset" Tag="None" Margin="2" Checked="BorderPreset_Changed"/>
                    </UniformGrid>
                    <CheckBox x:Name="ChkStripOldBorder"
                              Content="Recortar borde original (para convertir iconos BTN de WC3)"
                              FontSize="11"
                              Margin="0,0,0,10"
                              Checked="EditOption_Changed"
                              Unchecked="EditOption_Changed"/>

                    <Separator Margin="0,2,0,8"/>

                    <!-- 2. RECUADRO DE COLOR PERSONALIZADO -->
                    <CheckBox x:Name="ChkUseColorFrame"
                              Content="2. AGREGAR RECUADRO DE COLOR"
                              FontWeight="Bold"
                              FontSize="11"
                              Foreground="#005499"
                              Margin="0,0,0,6"
                              Checked="EditOption_Changed"
                              Unchecked="EditOption_Changed"/>

                    <Border BorderBrush="#C0C0C0" BorderThickness="1" Padding="8" Margin="0,0,0,10" Background="#FFFFFF">
                        <StackPanel>
                            <TextBlock Text="Colores rápidos o HEX (#RRGGBB):" FontSize="11" Foreground="#222222" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Width="22" Height="22" Margin="0,0,4,4" Background="#FFD700" Tag="#FFD700" ToolTip="Oro" Click="BtnFrameColorSwatch_Click"/>
                                <Button Width="22" Height="22" Margin="0,0,4,4" Background="#E53935" Tag="#E53935" ToolTip="Rojo" Click="BtnFrameColorSwatch_Click"/>
                                <Button Width="22" Height="22" Margin="0,0,4,4" Background="#1E88E5" Tag="#1E88E5" ToolTip="Azul" Click="BtnFrameColorSwatch_Click"/>
                                <Button Width="22" Height="22" Margin="0,0,4,4" Background="#43A047" Tag="#43A047" ToolTip="Verde" Click="BtnFrameColorSwatch_Click"/>
                                <Button Width="22" Height="22" Margin="0,0,4,4" Background="#9C27B0" Tag="#9C27B0" ToolTip="Morado Épico" Click="BtnFrameColorSwatch_Click"/>
                                <Button Width="22" Height="22" Margin="0,0,4,4" Background="#00E5FF" Tag="#00E5FF" ToolTip="Cian" Click="BtnFrameColorSwatch_Click"/>
                                <Button Width="22" Height="22" Margin="0,0,4,4" Background="#FF6D00" Tag="#FF6D00" ToolTip="Naranja Legendario" Click="BtnFrameColorSwatch_Click"/>
                                <Button Width="22" Height="22" Margin="0,0,4,4" Background="#FFFFFF" BorderBrush="#666666" BorderThickness="1" Tag="#FFFFFF" ToolTip="Blanco" Click="BtnFrameColorSwatch_Click"/>
                            </WrapPanel>

                            <DockPanel Margin="0,0,0,6">
                                <Border x:Name="BorderSelectedFrameColor" DockPanel.Dock="Left" Width="26" Height="22" BorderBrush="#444444" BorderThickness="1" Background="#FFD228" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtFrameColorHex" Style="{StaticResource Win10TextBox}" Text="#FFD228" Foreground="#111111" TextChanged="TxtFrameColorHex_TextChanged"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Estilo:" Foreground="#222222" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                <ComboBox Grid.Column="1" x:Name="CmbColorFrameStyle" SelectedIndex="0" FontSize="11" SelectionChanged="CmbColorFrameStyle_SelectionChanged">
                                    <ComboBoxItem Content="Recuadro Sólido" Tag="SolidBox"/>
                                    <ComboBoxItem Content="Resplandor / Glow" Tag="GlowingBox"/>
                                    <ComboBoxItem Content="Esquineros (Corner)" Tag="CornerBrackets"/>
                                </ComboBox>
                            </Grid>

                            <DockPanel>
                                <TextBlock x:Name="TxtFrameThickness" DockPanel.Dock="Right" Text="3 px" Width="34" TextAlignment="Right" Foreground="#222222" FontSize="11"/>
                                <TextBlock DockPanel.Dock="Left" Text="Grosor:" Foreground="#222222" Margin="0,0,6,0" FontSize="11"/>
                                <Slider x:Name="SldFrameThickness" Minimum="1" Maximum="6" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderOption_Changed"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,2,0,8"/>

                    <!-- 3. AJUSTES DE IMAGEN Y TINTE -->
                    <TextBlock Text="3. AJUSTES DE IMAGEN" FontWeight="Bold" FontSize="11" Foreground="#005499" Margin="0,0,0,6"/>

                    <DockPanel Margin="0,2">
                        <TextBlock x:Name="TxtZoomVal" DockPanel.Dock="Right" Text="100%" Width="40" TextAlignment="Right" FontSize="11"/>
                        <TextBlock DockPanel.Dock="Left" Text="Zoom:" Width="66" FontSize="11"/>
                        <Slider x:Name="SldZoom" Minimum="75" Maximum="145" Value="100" ValueChanged="SliderOption_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="0,2">
                        <TextBlock x:Name="TxtBrightnessVal" DockPanel.Dock="Right" Text="0" Width="40" TextAlignment="Right" FontSize="11"/>
                        <TextBlock DockPanel.Dock="Left" Text="Brillo:" Width="66" FontSize="11"/>
                        <Slider x:Name="SldBrightness" Minimum="-80" Maximum="80" Value="0" ValueChanged="SliderOption_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="0,2">
                        <TextBlock x:Name="TxtContrastVal" DockPanel.Dock="Right" Text="0" Width="40" TextAlignment="Right" FontSize="11"/>
                        <TextBlock DockPanel.Dock="Left" Text="Contraste:" Width="66" FontSize="11"/>
                        <Slider x:Name="SldContrast" Minimum="-50" Maximum="50" Value="0" ValueChanged="SliderOption_Changed"/>
                    </DockPanel>

                    <CheckBox x:Name="ChkFlipH" Content="Voltear horizontalmente" FontSize="11" Margin="0,4,0,4" Checked="EditOption_Changed" Unchecked="EditOption_Changed"/>

                    <CheckBox x:Name="ChkUseTint" Content="Aplicar tinte de color a la imagen" FontSize="11" Margin="0,2,0,4" Checked="EditOption_Changed" Unchecked="EditOption_Changed"/>
                    <Grid Margin="14,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BorderTintColor" Grid.Column="0" Width="20" Height="20" BorderBrush="#555555" BorderThickness="1" Background="#FF4444" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtTintColorHex" Style="{StaticResource Win10TextBox}" Text="#FF4444" FontSize="10.5" TextChanged="TxtTintColorHex_TextChanged"/>
                        <Slider Grid.Column="2" x:Name="SldTintStrength" Minimum="5" Maximum="90" Value="35" Margin="6,0,0,0" ValueChanged="SliderOption_Changed"/>
                    </Grid>

                    <Button Content="↺ Restablecer Ajustes" Style="{StaticResource Win10ClassicButton}" Padding="8,4" Margin="0,4,0,0" Click="BtnResetAdjustments_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- BARRA INFERIOR DE GUARDADO Y EXPORTACIÓN -->
        <Border Grid.Row="2" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="8,6" Margin="0,8,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11.5" Text="Listo. Edita tu icono y guárdalo en Importaciones."/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Win10ClassicButton}"
                            Padding="10,5"
                            Margin="0,0,8,0"
                            Click="BtnExportToDisk_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/export_file.png" Width="15" Height="15" Margin="0,0,5,0"/>
                            <TextBlock Text="Exportar .BLP / .PNG a PC..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnSaveToImports"
                            Style="{StaticResource Win10ClassicButton}"
                            Padding="12,5"
                            Background="#DDF4DF"
                            BorderBrush="#2EA043"
                            FontWeight="Bold"
                            Click="BtnSaveToImports_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/save_compile.png" Width="15" Height="15" Margin="0,0,5,0"/>
                            <TextBlock Text="Guardar en Importaciones (+ DISBTN)" Foreground="#111111" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

