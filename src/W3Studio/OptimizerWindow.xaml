<Window x:Class="W3Studio.OptimizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimizador — WC3 Map Optimizer 5.0"
        Icon="pack://application:,,,/Assets/W3Studio.ico"
        Width="1020" Height="700" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win10WindowBg}"
        Foreground="{DynamicResource Win10Text}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra superior: Archivos Origen / Destino -->
        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mapa Origen:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtSourcePath" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,6,0" IsReadOnly="True" Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource Win10Border}"/>
                <Button x:Name="BtnUseActiveMap" Grid.Row="0" Grid.Column="2" Style="{StaticResource Win10ClassicButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnUseActiveMap_Click" ToolTip="Cargar la ruta del mapa actualmente abierto en W3 Studio">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/map_active.png" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Mapa Abierto" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource Win10ClassicButton}" Padding="10,4" Click="BtnBrowseSource_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/open.png" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Seleccionar .w3x..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Mapa Destino:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtOutputPath" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,4" Margin="0,0,6,0" BorderBrush="{DynamicResource Win10Border}"/>
                <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource Win10ClassicButton}" Padding="10,4" Click="BtnBrowseOutput_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/save.png" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Guardar Como..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Barra de Presets rápidos (estilo WC3 Map Optimizer 5.0) -->
        <Border Grid.Row="1" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Perfiles Rápidos:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource Win10ClassicButton}" Padding="9,3" Margin="0,0,6,0" Click="BtnPresetRecommended_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/optimizer.png" Width="14" Height="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Recomendado (Equilibrado)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Win10ClassicButton}" Padding="9,3" Margin="0,0,6,0" Click="BtnPresetMaxProtect_Click" Background="{DynamicResource ThemeWarningBg}" BorderBrush="{DynamicResource ThemeWarningBorder}" Foreground="{DynamicResource ThemeWarningText}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/protect.png" Width="14" Height="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Máxima Compresión + Proteger Mapa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Win10ClassicButton}" Padding="9,3" Click="BtnPresetSafeClean_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/clean.png" Width="14" Height="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Solo Limpiar JASS y Strings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TxtSourceBadge" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentText}" Text="Sin mapa seleccionado"/>
            </DockPanel>
        </Border>

        <!-- Cuerpo Principal: Izquierda (Opciones WC3 Optimizer 5.0) | Derecha (Análisis y Log) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna Izquierda: Opciones -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,2,0">
                    <!-- Sección 1: Tweaks / Script JASS -->
                    <Border Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="1. TWEAKS / OPTIMIZACIÓN DE SCRIPT (war3map.j)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,8"/>

                            <CheckBox x:Name="ChkRemoveJassComments" Content="Eliminar comentarios (// ...) y líneas vacías del JASS" IsChecked="True" Margin="0,0,0,5"/>
                            <CheckBox x:Name="ChkCompactJassWhitespace" Content="Compactar espacios e indentación innecesaria" IsChecked="True" Margin="0,0,0,5"/>
                            <CheckBox x:Name="ChkInlineTrigStrings" Content="Incrustar TRIGSTR_xxx de war3map.wts directo en el JASS (Inline strings)" IsChecked="True" Margin="0,0,0,5"/>
                            <CheckBox x:Name="ChkRemoveDebugLines" Content="Eliminar líneas que empiezan con la palabra clave 'debug'" IsChecked="True" Margin="0,0,0,5"/>
                            <CheckBox x:Name="ChkCompressJassNames" Content="Ofuscar / comprimir nombres de funciones, globals y locales (A-Za-z)" IsChecked="True" Margin="0,0,0,5" ToolTip="Renombra identificadores propios por nombres cortos (a, b, c...) respetando common.j, blizzard.j, main, config y cadenas."/>
                            <CheckBox x:Name="ChkValidateWithPjass" Content="Validar script JASS resultante con PJASS antes de guardar (revertir si falla)" IsChecked="True" Margin="0,0,0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- Sección 2: Remove / Limpieza de Editor -->
                    <Border Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="2. ELIMINAR ARCHIVOS SOLO-EDITOR Y LIMPIEZA (BLOAT)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,8"/>

                            <CheckBox x:Name="ChkRemoveEditorTriggerFiles" Content="Eliminar archivos GUI de editor (.wtg, .wct, .imp) [Protege Triggers]" IsChecked="True" Margin="0,0,0,5" ToolTip="Warcraft III ejecuta únicamente war3map.j; quitar .wtg/.wct ahorra espacio e impide abrir los triggers en World Editor."/>
                            <CheckBox x:Name="ChkCleanUnusedWtsStrings" Content="Depurar war3map.wts eliminando strings huérfanos sin usar" IsChecked="True" Margin="0,0,0,5"/>
                            <CheckBox x:Name="ChkCleanObjectDataStrings" Content="Limpiar referencias innecesarias en Object Data (experimental)" IsChecked="True" Margin="0,0,0,5"/>
                            <CheckBox x:Name="ChkRemoveEditorSoundsFile" Content="Eliminar war3map.w3s (Solo si los sonidos se manejan por JASS/datos)" IsChecked="False" Margin="0,0,0,5"/>
                            <CheckBox x:Name="ChkRemoveEditorCamerasFile" Content="Eliminar war3map.w3c (Solo si no usas cámaras predefinidas)" IsChecked="False" Margin="0,0,0,5"/>
                            <CheckBox x:Name="ChkRemoveMapPreviewImage" Content="Eliminar imagen de vista previa en lobby (war3mapPreview.tga)" IsChecked="False" Margin="0,0,0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- Sección 3: MPQ & Protección -->
                    <Border Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="3. COMPRESIÓN MPQ Y PROTECCIÓN CLÁSICA" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,8"/>

                            <CheckBox x:Name="ChkRecompressAllMpqFiles" Content="Reempaquetar y recomprimir todos los archivos del archivo MPQ" IsChecked="True" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkRemoveListfileAndAttributes" IsChecked="False" Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Proteger mapa: Eliminar "/>
                                    <Run Text="(listfile)" FontWeight="SemiBold"/>
                                    <Run Text=" y atributos del MPQ (impide abrir en World Editor, jugable en WC3)"/>
                                </TextBlock>
                            </CheckBox>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tamaño de bloque MPQ (Block Size):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbMpqBlockSize" Grid.Column="1" SelectedIndex="1" Padding="6,3">
                                    <ComboBoxItem Content="2048 bytes (2 KB — Sector pequeño)" Tag="2"/>
                                    <ComboBoxItem Content="4096 bytes (4 KB — Estándar WC3)" Tag="3"/>
                                    <ComboBoxItem Content="8192 bytes (8 KB — Mejor compresión archivos grandes)" Tag="4"/>
                                    <ComboBoxItem Content="16384 bytes (16 KB — Máximo tamaño de bloque)" Tag="5"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Columna Derecha: Análisis de Peso, Ahorro y Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Análisis del Mapa -->
                <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="ANÁLISIS DE PESO DEL MAPA ORIGEN" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeAccentText}"/>
                            <Button DockPanel.Dock="Right" Content="🔄 Reanalizar" Style="{StaticResource Win10ClassicButton}" Padding="8,2" FontSize="11" Click="BtnAnalyze_Click"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Archivo .w3x total:" Margin="0,2"/>
                            <TextBlock x:Name="LblTotalSource" Grid.Row="0" Grid.Column="1" Text="—" FontWeight="Bold" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Archivos dentro MPQ:" Margin="0,2"/>
                            <TextBlock x:Name="LblFileCount" Grid.Row="0" Grid.Column="4" Text="—" FontWeight="Bold" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Script JASS (war3map.j):" Margin="0,2"/>
                            <TextBlock x:Name="LblJassSize" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Solo Editor (.wtg/.wct/.imp):" Margin="0,2"/>
                            <TextBlock x:Name="LblEditorSize" Grid.Row="1" Grid.Column="4" Text="—" Foreground="{DynamicResource ThemeAccentText}" FontWeight="SemiBold" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Object Data (.w3u/.w3a...):" Margin="0,2"/>
                            <TextBlock x:Name="LblObjectSize" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Terreno / Doo / Regiones:" Margin="0,2"/>
                            <TextBlock x:Name="LblTerrainSize" Grid.Row="2" Grid.Column="4" Text="—" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Importaciones (BLP/MDX/WAV):" Margin="0,2"/>
                            <TextBlock x:Name="LblImportsSize" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Text="Otros (wts/txt/miscellaneous):" Margin="0,2"/>
                            <TextBlock x:Name="LblOtherSize" Grid.Row="3" Grid.Column="4" Text="—" Margin="0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Resumen de Optimización -->
                <Border Grid.Row="1" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ANTES ➔ DESPUÉS" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LblBeforeAfter" Text="— ➔ —" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Win10Text}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ESPACIO AHORRADO" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LblSavedStats" Text="0 KB (0%)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="IDENTIFICADORES / PJASS" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LblScriptStats" Text="Pendiente" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log de Ejecución -->
                <Border Grid.Row="2" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="REGISTRO DE OPTIMIZACIÓN" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtLog"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 Background="#1A1D21"
                                 Foreground="#D6E2EE"
                                 BorderThickness="0"
                                 Padding="8"
                                 Text="Listo. Selecciona un mapa origen y configura las opciones de WC3 Map Optimizer 5.0."/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Barra inferior -->
        <Border Grid.Row="3" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10,8" Margin="0,8,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtWarningNote"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource ThemeTextMuted}"
                           Text="💡 Siempre se genera un archivo nuevo (_optimized.w3x) para no dañar tu mapa editable original."/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnOpenOutputFolder" Style="{StaticResource Win10ClassicButton}" Padding="12,5" Margin="0,0,8,0" IsEnabled="False" Click="BtnOpenOutputFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/category_folder.png" Width="14" Height="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Abrir Carpeta Destino" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRunOptimize" Style="{StaticResource Win10ClassicButton}" Padding="16,5" FontWeight="Bold" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" Foreground="{DynamicResource ThemeSuccessText}" Click="BtnRunOptimize_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/Icons/optimizer.png" Width="15" Height="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Optimizar Mapa" Foreground="{DynamicResource ThemeSuccessText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

