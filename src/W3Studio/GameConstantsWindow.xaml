<Window x:Class="W3Studio.GameConstantsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avanzado — Gameplay Constants &amp; Game Interface"
        Icon="pack://application:,,,/Assets/W3Studio.ico"
        Width="1040" Height="690" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win10WindowBg}"
        Foreground="{DynamicResource Win10Text}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="TabsAdvanced" Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}">
            <!-- TAB 1: GAMEPLAY CONSTANTS (war3mapMisc.txt) -->
            <TabItem x:Name="TabMisc">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/constants.png" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Constantes de Juego (Gameplay Constants / war3mapMisc.txt)" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Categoría:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbMiscCategory" Width="170" Padding="6,3" Margin="0,0,10,0" SelectionChanged="MiscFilter_Changed"/>
                            <TextBlock Text="Buscar:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtMiscSearch" Width="230" Style="{StaticResource Win10TextBox}" Padding="5,3" Margin="0,0,10,0" TextChanged="MiscFilter_Changed"/>
                            <CheckBox x:Name="ChkMiscModifiedOnly" Content="Solo modificados" VerticalAlignment="Center" Checked="MiscFilter_Changed" Unchecked="MiscFilter_Changed"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right" Style="{StaticResource Win10ClassicButton}" Padding="10,4" Click="BtnResetMiscRow_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Assets/Icons/reset.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                <TextBlock Text="Restaurar Fila" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <DataGrid x:Name="GridMisc"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              RowHeight="26"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderBrush="{DynamicResource Win10Border}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="125" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Parámetro (Gameplay Constant)" Binding="{Binding DisplayName}" Width="290" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Clave" Binding="{Binding Key}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Valor Actual (Editable)" Binding="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}" Width="250" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Por Defecto (WC3)" Binding="{Binding DefaultValue}" Width="180" IsReadOnly="True" Foreground="{DynamicResource ThemeTextMuted}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" x:Name="TxtMiscSummary" Text="0 modificados" Foreground="{DynamicResource ThemeAccentText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>

            <!-- TAB 2: GAME INTERFACE (war3mapSkin.txt) -->
            <TabItem x:Name="TabSkin">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/icon_manager.png" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Interfaz de Juego (Game Interface / war3mapSkin.txt)" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tipo:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbSkinCategory" Width="170" Padding="6,3" Margin="0,0,10,0" SelectionChanged="SkinFilter_Changed"/>
                            <TextBlock Text="Buscar:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtSkinSearch" Width="210" Style="{StaticResource Win10TextBox}" Padding="5,3" Margin="0,0,10,0" TextChanged="SkinFilter_Changed"/>
                            <CheckBox x:Name="ChkSkinModifiedOnly" Content="Solo modificados" VerticalAlignment="Center" Checked="SkinFilter_Changed" Unchecked="SkinFilter_Changed"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Win10ClassicButton}" Padding="9,4" Margin="0,0,6,0" Click="BtnPickSkinIcon_Click" ToolTip="Elegir un icono .blp con vista previa">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/Icons/image_file.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                    <TextBlock Text="Icono..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Win10ClassicButton}" Padding="9,4" Margin="0,0,6,0" Click="BtnPickSkinModel_Click" ToolTip="Elegir un modelo .mdx con vista previa">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/Icons/model_3d.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                    <TextBlock Text="Modelo..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Win10ClassicButton}" Padding="9,4" Click="BtnResetSkinRow_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/Icons/reset.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                    <TextBlock Text="Restaurar Fila" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid x:Name="GridSkin"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              RowHeight="26"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderBrush="{DynamicResource Win10Border}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Category}" Width="135" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sección" Binding="{Binding Section}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Clave (Key)" Binding="{Binding Key}" Width="210" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Valor Actual (Editable)" Binding="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}" Width="290" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Por Defecto (WC3)" Binding="{Binding DefaultValue}" Width="220" IsReadOnly="True" Foreground="{DynamicResource ThemeTextMuted}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" x:Name="TxtSkinSummary" Text="0 modificados" Foreground="{DynamicResource ThemeAccentText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10,8" Margin="0,8,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" Text="💡 Solo los valores distintos al predeterminado de Warcraft III se escriben en war3mapMisc.txt / war3mapSkin.txt."/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource Win10ClassicButton}" Padding="14,5" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button Content="✓ Aplicar Cambios al Mapa" Style="{StaticResource Win10ClassicButton}" Padding="16,5" FontWeight="Bold" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" Foreground="{DynamicResource ThemeSuccessText}" Click="BtnApply_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

