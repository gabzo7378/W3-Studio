<Window x:Class="W3Studio.ObjectListPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selector de Objetos y Habilidades — Warcraft III 1.27b"
        Icon="pack://application:,,,/Assets/W3Studio.ico"
        Width="860" Height="580"
        MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win10WindowBg}"
        Foreground="{DynamicResource Win10Text}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="TxtHeaderTitle" Text="Habilidades de Héroe (uhab)" FontWeight="Bold" FontSize="13.5"/>
                <TextBlock x:Name="TxtHeaderSubtitle" Text="Doble clic en el catálogo derecho para agregar elementos, o usa los botones para ordenar y quitar." Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Cuerpo dividido: Izquierda (Asignados) | Derecha (Catálogo Disponible) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Elementos Asignados -->
            <Border Grid.Column="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="LblAssignedHeader" Grid.Row="0" Text="Elementos Asignados (0):" FontWeight="Bold" Margin="0,0,0,6"/>

                    <ListBox Grid.Row="1"
                             x:Name="LstAssigned"
                             Background="{DynamicResource ThemeInputBg}"
                             Foreground="{DynamicResource Win10Text}"
                             BorderBrush="{DynamicResource Win10Border}"
                             MouseDoubleClick="LstAssigned_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,2">
                                    <Border Width="22" Height="22" BorderBrush="#666666" BorderThickness="1" Margin="0,0,6,0" Background="#111111">
                                        <Image Source="{Binding Icon}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,8,0,0">
                        <Button x:Name="BtnMoveUp" Content="↑ Subir" Style="{DynamicResource Win10ClassicButton}" Padding="4,3" Margin="0,0,3,0" Click="BtnMoveUp_Click"/>
                        <Button x:Name="BtnMoveDown" Content="↓ Bajar" Style="{DynamicResource Win10ClassicButton}" Padding="4,3" Margin="0,0,3,0" Click="BtnMoveDown_Click"/>
                        <Button x:Name="BtnRemoveSelected" Content="✕ Quitar" Style="{DynamicResource Win10ClassicButton}" Padding="4,3" Margin="0,0,3,0" Click="BtnRemoveSelected_Click"/>
                        <Button x:Name="BtnClearAll" Content="Vaciar" Style="{DynamicResource Win10ClassicButton}" Padding="4,3" Click="BtnClearAll_Click"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Panel Derecho: Catálogo Completo con Filtro de Raza/Categoría y Búsqueda -->
            <Border Grid.Column="2" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock x:Name="LblCatalogHeader" Text="Catálogo Disponible:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbRaceFilter" DockPanel.Dock="Right" Width="175" Height="24" SelectionChanged="CmbRaceFilter_SelectionChanged"/>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock x:Name="LblSearch" Text="Buscar:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtSearch" Style="{DynamicResource Win10TextBox}" Height="25" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                    </DockPanel>

                    <ListBox Grid.Row="2"
                             x:Name="LstCatalog"
                             Background="{DynamicResource ThemeInputBg}"
                             Foreground="{DynamicResource Win10Text}"
                             BorderBrush="{DynamicResource Win10Border}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="LstCatalog_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,2">
                                    <Border Width="22" Height="22" BorderBrush="#666666" BorderThickness="1" Margin="0,0,6,0" Background="#111111">
                                        <Image Source="{Binding Icon}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SubInfo}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" x:Name="BtnAddSelected" Content="← Agregar Seleccionado a la Lista" Style="{DynamicResource Win10ClassicButton}" Height="27" Margin="0,8,0,0" FontWeight="SemiBold" Click="BtnAddSelected_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Vista previa del valor raw -->
        <Border Grid.Row="2" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,8,0,10">
            <DockPanel>
                <TextBlock x:Name="LblRawPreview" Text="Rawcodes (CSV):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtRawPreview" Style="{DynamicResource Win10TextBox}" Height="24" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="11.5" TextChanged="TxtRawPreview_TextChanged"/>
            </DockPanel>
        </Border>

        <!-- Botones Aceptar / Cancelar -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="BtnCancel" Content="Cancelar" DockPanel.Dock="Right" Width="90" Height="27" Margin="6,0,0,0" Style="{DynamicResource Win10ClassicButton}" IsCancel="True"/>
            <Button x:Name="BtnOk" Content="Aceptar" DockPanel.Dock="Right" Width="90" Height="27" Style="{DynamicResource Win10ClassicButton}" IsDefault="True" Click="BtnOk_Click"/>
        </DockPanel>
    </Grid>
</Window>

