<Window x:Class="W3Studio.ScenarioWindow"
        
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escenario — Propiedades del Mapa, Jugadores y Fuerzas"
        Icon="pack://application:,,,/Assets/W3Studio.ico"
        Width="980" Height="680" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Win10WindowBg}"
        Foreground="{DynamicResource Win10Text}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="TabsScenario" Grid.Row="0" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}">
            <!-- TAB 1: DESCRIPCIÓN Y OPCIONES DEL MAPA -->
            <TabItem x:Name="TabDescription">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/scenario.png" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Descripción, Pantalla de Carga y Ambiente"
                                   Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                   FontWeight="{Binding (TextElement.FontWeight), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Izquierda: Datos Generales & Loading Screen -->
                        <StackPanel Grid.Column="0">
                            <Border Background="{DynamicResource Win10WindowBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="INFORMACIÓN DEL MAPA (war3map.w3i)" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Nombre del Mapa:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtMapName" Style="{StaticResource Win10TextBox}" Padding="5,3" Margin="0,0,0,8"/>
                                    <TextBlock Text="Autor:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtMapAuthor" Style="{StaticResource Win10TextBox}" Padding="5,3" Margin="0,0,0,8"/>
                                    <TextBlock Text="Jugadores Sugeridos (ej. 'Any', '3v3', '1-8 RPG'):" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtSuggestedPlayers" Style="{StaticResource Win10TextBox}" Padding="5,3" Margin="0,0,0,8"/>
                                    <TextBlock Text="Descripción:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtMapDescription" Style="{StaticResource Win10TextBox}" Height="78" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5,4"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Win10WindowBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="PANTALLA DE CARGA (LOADING SCREEN)" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Fondo / Modelo (.mdx custom o campaña):" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtLoadingPath" Grid.Column="0" Style="{StaticResource Win10TextBox}" Padding="5,3" Margin="0,0,6,0" ToolTip="Ej. LoadingScreen.mdx (vacío usa predeterminado o campaña)"/>
                                        <Button Grid.Column="1" Style="{StaticResource Win10ClassicButton}" Padding="8,3" Click="BtnPickLoadingModel_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/Assets/Icons/model_3d.png" Width="14" Height="14" Margin="0,0,5,0"/>
                                                <TextBlock Text="Modelo..." VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Título:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                            <TextBox x:Name="TxtLoadingTitle" Style="{StaticResource Win10TextBox}" Padding="5,3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Subtítulo:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                            <TextBox x:Name="TxtLoadingSubtitle" Style="{StaticResource Win10TextBox}" Padding="5,3"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Texto de Carga:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtLoadingText" Style="{StaticResource Win10TextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5,3"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- Derecha: Map Options, Flags, Tileset, Ambiente / Niebla -->
                        <StackPanel Grid.Column="2">
                            <Border Background="{DynamicResource Win10WindowBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="OPCIONES Y BANDERAS DEL MAPA (MAP OPTIONS)" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tileset Base:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="CmbTileset" Grid.Column="1" Padding="6,3"/>
                                    </Grid>
                                    <CheckBox x:Name="ChkMaskPartiallyVisible" Content="Áreas exploradas parcialmente visibles (Masked areas partially visible)" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkHideMinimap" Content="Ocultar minimapa en pantalla de vista previa" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkUseCustomForces" Content="Usar Fuerzas Personalizadas (Use Custom Forces)" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkFixedPlayerSettings" Content="Configuración fija de jugadores para fuerzas (Fixed Player Settings)" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkWavesCliff" Content="Mostrar olas en orillas de acantilados" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkWavesRolling" Content="Mostrar olas en orillas de terreno suave" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkUseItemClassification" Content="Usar sistema de clasificación de ítems" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkUseCustomTechtree" Content="Árbol tecnológico personalizado (Custom Techtree)" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkUseCustomAbilities" Content="Habilidades personalizadas (Custom Abilities)" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ChkUseCustomUpgrades" Content="Mejoras personalizadas (Custom Upgrades)" Margin="0,0,0,2"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Win10WindowBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="AMBIENTE, CLIMA Y NIEBLA (FOG / WEATHER)" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Clima Global:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="CmbWeather" Grid.Column="1" Padding="6,3"/>
                                    </Grid>
                                    <CheckBox x:Name="ChkHasTerrainFog" Content="Activar Niebla de Terreno (Terrain Fog)" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Estilo de Niebla:" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbFogStyle" Grid.Column="1" Padding="6,3"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Z Start:" FontSize="11"/>
                                            <TextBox x:Name="TxtFogStart" Style="{StaticResource Win10TextBox}" Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Z End:" FontSize="11"/>
                                            <TextBox x:Name="TxtFogEnd" Style="{StaticResource Win10TextBox}" Padding="4,2"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Densidad (0..1):" FontSize="11"/>
                                            <TextBox x:Name="TxtFogDensity" Style="{StaticResource Win10TextBox}" Padding="4,2"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Color Niebla (R,G,B):" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtFogColorRgb" Grid.Column="1" Style="{StaticResource Win10TextBox}" Padding="5,2" ToolTip="Formato: R, G, B (0-255)"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tinte Agua (R,G,B,A):" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtWaterColorRgba" Grid.Column="1" Style="{StaticResource Win10TextBox}" Padding="5,2" ToolTip="Formato: R, G, B, A (0-255)"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <!-- TAB 2: PROPIEDADES DE JUGADORES -->
            <TabItem x:Name="TabPlayers">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/tab_units.png" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Propiedades de Jugadores (Player Properties)"
                                   Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                   FontWeight="{Binding (TextElement.FontWeight), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Configura cada ranura de jugador (Player 1 - Player 12). Estos cambios actualizan war3map.w3i y config() / InitCustomPlayerSlots() en war3map.j." Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,8"/>
                    <DataGrid x:Name="GridPlayers"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeight="28"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderBrush="{DynamicResource Win10Border}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding PlayerNumber}" Width="40" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Color" Binding="{Binding ColorLabel}" Width="105" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nombre del Jugador" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
                            <DataGridComboBoxColumn Header="Controlador (Type)"
                                                    SelectedItemBinding="{Binding Controller, UpdateSourceTrigger=PropertyChanged}"
                                                    x:Name="ColPlayerController"
                                                    Width="130"/>
                            <DataGridComboBoxColumn Header="Raza (Race)"
                                                    SelectedItemBinding="{Binding Race, UpdateSourceTrigger=PropertyChanged}"
                                                    x:Name="ColPlayerRace"
                                                    Width="120"/>
                            <DataGridCheckBoxColumn Header="Pos. Inicial Fija" Binding="{Binding FixedStartLocation, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="Start X" Binding="{Binding StartX, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTextColumn Header="Start Y" Binding="{Binding StartY, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!-- TAB 3: FUERZAS Y ALIANZAS -->
            <TabItem x:Name="TabForces">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/Icons/scenario.png" Width="14" Height="14" Margin="0,0,5,0"/>
                        <TextBlock Text="Fuerzas y Alianzas (Forces)"
                                   Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                   FontWeight="{Binding (TextElement.FontWeight), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Lista de Fuerzas -->
                    <Border Grid.Column="0" Background="{DynamicResource Win10WindowBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="FUERZAS / EQUIPOS" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,6"/>
                            <ListBox x:Name="LstForces" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="LstForces_SelectionChanged" BorderBrush="{DynamicResource Win10Border}" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Style="{StaticResource Win10ClassicButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnAddForce_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/Icons/add.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                        <TextBlock Text="Agregar Fuerza" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Win10ClassicButton}" Padding="10,4" Click="BtnRemoveForce_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/Icons/delete.png" Width="13" Height="13" Margin="0,0,4,0"/>
                                        <TextBlock Text="Quitar Fuerza" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Detalle de Fuerza Seleccionada -->
                    <Border Grid.Column="2" Background="{DynamicResource Win10WindowBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="12">
                        <StackPanel x:Name="PnlForceEditor" IsEnabled="False">
                            <TextBlock Text="CONFIGURACIÓN DE FUERZA SELECCIONADA" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,0,8"/>
                            <TextBlock Text="Nombre de la Fuerza:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtForceName" Style="{StaticResource Win10TextBox}" Padding="6,3" Margin="0,0,0,12" TextChanged="TxtForceName_TextChanged"/>
                            <TextBlock Text="Banderas de Alianza:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <CheckBox x:Name="ChkForceAllied" Content="Allied (Aliados)" Margin="0,2" Checked="ForceFlag_Changed" Unchecked="ForceFlag_Changed"/>
                                <CheckBox x:Name="ChkForceAlliedVictory" Content="Allied Victory (Victoria compartida)" Margin="0,2" Checked="ForceFlag_Changed" Unchecked="ForceFlag_Changed"/>
                                <CheckBox x:Name="ChkForceShareVision" Content="Share Vision (Visión compartida)" Margin="0,2" Checked="ForceFlag_Changed" Unchecked="ForceFlag_Changed"/>
                                <CheckBox x:Name="ChkForceShareControl" Content="Share Unit Control (Control básico)" Margin="0,2" Checked="ForceFlag_Changed" Unchecked="ForceFlag_Changed"/>
                                <CheckBox x:Name="ChkForceShareAdvControl" Content="Share Advanced Unit Control" Margin="0,2" Checked="ForceFlag_Changed" Unchecked="ForceFlag_Changed"/>
                            </UniformGrid>
                            <TextBlock Text="Jugadores pertenecientes a esta Fuerza:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="WpForcePlayers"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <!-- Barra Inferior -->
        <Border Grid.Row="1" Background="{DynamicResource Win10PanelBg}" BorderBrush="{DynamicResource Win10Border}" BorderThickness="1" Padding="10,8" Margin="0,8,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}" Text="💡 Al pulsar 'Aplicar y Guardar', se actualizará war3map.w3i y las funciones config() / InitCustomTeams()."/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource Win10ClassicButton}" Padding="14,5" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button Content="✓ Aplicar Cambios al Mapa" Style="{StaticResource Win10ClassicButton}" Padding="16,5" FontWeight="Bold" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" Foreground="{DynamicResource ThemeSuccessText}" Click="BtnApply_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

